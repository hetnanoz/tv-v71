'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    rngSource As Excel.Range, strText As String, blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       String
' Description:   Applies Oracle-only display normalization to selected numeric report fields.
'-------------------------------------------------------------------------------
Private Function NormalizeOracleFieldDisplayText( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As String

    Const METHOD_NAME As String = "NormalizeOracleFieldDisplayText"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCommaPosition As Long
    Dim lngDecimalPosition As Long
    Dim lngDotPosition As Long
    Dim rngValue As Excel.Range
    Dim strResult As String

    On Error GoTo ErrorHandler

    NormalizeOracleFieldDisplayText = strText

    If Len(strText) = 0 Then
        GoTo ExitFunction
    End If

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    If IsError(rngValue.Value) Or IsEmpty(rngValue.Value) Then
        GoTo ExitFunction
    End If

    If IsDate(rngValue.Value) Or Not IsNumeric(rngValue.Value) Then
        GoTo ExitFunction
    End If

    ' Oracle display rule: preserve the worksheet's thousands separator and
    ' decimal separator, but remove non-significant zeroes at the end of the
    ' fractional part. This is PDF-only formatting; source values are untouched.
    strResult = Trim$(strText)

    lngDotPosition = InStrRev(strResult, ".")
    lngCommaPosition = InStrRev(strResult, ",")

    If lngDotPosition > lngCommaPosition Then
        lngDecimalPosition = lngDotPosition
    Else
        lngDecimalPosition = lngCommaPosition
    End If

    If lngDecimalPosition > 0 Then
        Do While Len(strResult) > lngDecimalPosition And _
                 Right$(strResult, 1) = "0"
            strResult = Left$(strResult, Len(strResult) - 1)
        Loop

        If Len(strResult) = lngDecimalPosition Then
            strResult = Left$(strResult, lngDecimalPosition - 1)
        End If
    End If

    If IsOracleGroupedNumericDisplayField( _
        blnTopTransactionRow, _
        lngFieldIndex) Then

        strResult = FormatOracleGroupedNumericText(strResult)
    End If

    ' Oracle number pictures suppress the integer zero for non-zero
    ' fractional values: 0.96 -> .96, -0.5 -> -.5. This rule is applied
    ' centrally to every numeric PDF field; worksheet values stay unchanged.
    strResult = SuppressOracleFractionLeadingZero(strResult)

    NormalizeOracleFieldDisplayText = strResult

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    NormalizeOracleFieldDisplayText = strText

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topTransactionRow;fieldIndex;text", _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    strText As String, blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       String
' Description:   Resolves the semantic Oracle data font independently of OLD/NEW aliases.
'-------------------------------------------------------------------------------
Private Function ResolveOracleDataFontResource( _
    ByVal strText As String, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As String

    Const METHOD_NAME As String = "ResolveOracleDataFontResource"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    ' FIX33: Storno Kauf / Storno Verkauf use semantic Times-Roman.
    ' OLD may expose that font under /F2 while NEW exposes it under /F1.
    ' Resource aliases are not semantic font identities.
    ResolveOracleDataFontResource = "/F1"

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveOracleDataFontResource = "/F1"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "text;topTransactionRow;fieldIndex", _
        strText, _
        blnTopTransactionRow, _
        lngFieldIndex

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       Long
' Description:   Resolves OLD Oracle leading-space counts for right-aligned numeric fields.
'-------------------------------------------------------------------------------
Private Function ResolveOracleNumericLeadingSpaces( _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long, _
    ByVal strNumericText As String) As Long

    Const METHOD_NAME As String = "ResolveOracleNumericLeadingSpaces"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIntegerDigits As Long

    On Error GoTo ErrorHandler

    ResolveOracleNumericLeadingSpaces = ORACLE_NUMERIC_LEADING_SPACES
    lngIntegerDigits = CountOracleIntegerDigits(strNumericText)

    If lngIntegerDigits <= 0 Then
        GoTo ExitFunction
    End If

    If blnTopTransactionRow Then
        Select Case lngFieldIndex
            Case TOP_FIELD_NOMINALE_INDEX
                ' V12: 1-3 digits -> 4 spaces; 4-6 -> 3.
                ResolveOracleNumericLeadingSpaces = _
                    ResolveOraclePictureLeadingSpaces( _
                        lngIntegerDigits, _
                        4, _
                        1)

            Case TOP_FIELD_KURS_INDEX
                ResolveOracleNumericLeadingSpaces = _
                    ResolveOraclePictureLeadingSpaces( _
                        lngIntegerDigits, _
                        3, _
                        0)

            Case TOP_FIELD_STUECKZINSEN_INDEX
                ResolveOracleNumericLeadingSpaces = _
                    ResolveOraclePictureLeadingSpaces( _
                        lngIntegerDigits, _
                        5, _
                        1)
        End Select
    Else
        Select Case lngFieldIndex
            Case BOTTOM_FIELD_MAKLERGEBUEHREN_INDEX, _
                 BOTTOM_FIELD_STEUERN_INDEX, _
                 BOTTOM_FIELD_ABWICKLUNG_INDEX, _
                 BOTTOM_FIELD_SPESEN_INDEX, _
                 BOTTOM_FIELD_AMOUNT_WHG_INDEX, _
                 BOTTOM_FIELD_ABRECH_AMOUNT_INDEX

                ' V12 proved one common Oracle number picture:
                ' 1-3 integer digits -> 5 spaces
                ' 4-6                -> 4
                ' 7-9                -> 3
                ' 10-12              -> 2
                ResolveOracleNumericLeadingSpaces = _
                    ResolveOraclePictureLeadingSpaces( _
                        lngIntegerDigits, _
                        5, _
                        1)

            Case BOTTOM_FIELD_DEVISENKURS_INDEX
                ResolveOracleNumericLeadingSpaces = _
                    ResolveOraclePictureLeadingSpaces( _
                        lngIntegerDigits, _
                        2, _
                        0)
        End Select
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveOracleNumericLeadingSpaces = ORACLE_NUMERIC_LEADING_SPACES

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topTransactionRow;fieldIndex;numericText", _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strNumericText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    lngIntegerDigits As Long, lngFirstGroupSpaces As Long, lngMinimumSpaces As Long
' Returns:       Long
' Description:   Reproduces the Oracle Reports number-picture leading blanks:
'                one blank is removed for every additional three integer digits.
'-------------------------------------------------------------------------------
Private Function ResolveOraclePictureLeadingSpaces( _
    ByVal lngIntegerDigits As Long, _
    ByVal lngFirstGroupSpaces As Long, _
    ByVal lngMinimumSpaces As Long) As Long

    Const METHOD_NAME As String = "ResolveOraclePictureLeadingSpaces"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngDigitGroup As Long
    Dim lngResult As Long

    On Error GoTo ErrorHandler

    If lngIntegerDigits <= 0 Then
        ResolveOraclePictureLeadingSpaces = lngFirstGroupSpaces
        GoTo ExitFunction
    End If

    lngDigitGroup = (lngIntegerDigits - 1) \ 3
    lngResult = lngFirstGroupSpaces - lngDigitGroup

    If lngResult < lngMinimumSpaces Then
        lngResult = lngMinimumSpaces
    End If

    ResolveOraclePictureLeadingSpaces = lngResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveOraclePictureLeadingSpaces = lngFirstGroupSpaces

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "integerDigits;firstGroupSpaces;minimumSpaces", _
        lngIntegerDigits, _
        lngFirstGroupSpaces, _
        lngMinimumSpaces

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    strNumericText As String
' Returns:       Long
' Description:   Counts integer digits in the final PDF display text while
'                ignoring signs and grouping spaces.
'-------------------------------------------------------------------------------
Private Function CountOracleIntegerDigits( _
    ByVal strNumericText As String) As Long

    Const METHOD_NAME As String = "CountOracleIntegerDigits"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngComma As Long
    Dim lngDecimalPosition As Long
    Dim lngDot As Long
    Dim lngIndex As Long
    Dim lngStop As Long
    Dim strChar As String
    Dim strIntegerPrefix As String
    Dim strText As String

    On Error GoTo ErrorHandler

    strText = Trim$(strNumericText)

    If Len(strText) = 0 Then
        GoTo ExitFunction
    End If

    lngDot = InStrRev(strText, ".")
    lngComma = InStrRev(strText, ",")

    If lngDot > lngComma Then
        lngDecimalPosition = lngDot
    Else
        lngDecimalPosition = lngComma
    End If

    If lngDecimalPosition > 0 Then
        lngStop = lngDecimalPosition - 1
    Else
        lngStop = Len(strText)
    End If

    For lngIndex = 1 To lngStop
        strChar = Mid$(strText, lngIndex, 1)

        If strChar >= "0" And strChar <= "9" Then
            CountOracleIntegerDigits = _
                CountOracleIntegerDigits + 1
        End If
    Next lngIndex

    ' The displayed Oracle value .96 has no visible integer digit, but it
    ' still belongs to the 1-3 integer-digit number-picture bucket. Treat
    ' .96, -.96 and +.96 as one integer digit for leading-space padding.
    If CountOracleIntegerDigits = 0 And lngDecimalPosition > 0 Then
        strIntegerPrefix = Trim$( _
            Left$(strText, lngDecimalPosition - 1))

        If Len(strIntegerPrefix) = 0 Or _
           strIntegerPrefix = "-" Or _
           strIntegerPrefix = "+" Then

            CountOracleIntegerDigits = 1
        End If
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    CountOracleIntegerDigits = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "numericText", _
        strNumericText

    errorManager.save
    Resume ExitFunction
End Function


