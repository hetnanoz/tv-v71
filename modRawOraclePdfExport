        ' Blueprint V3 OLD: the blank numeric shows decode to five spaces.
        ' Use the same marker for any already-active data clip so the operator
        ' remains non-visible while preserving Oracle text-show occupancy.
        ResolveOracleBlankClipText = Space$(5)
    End If

