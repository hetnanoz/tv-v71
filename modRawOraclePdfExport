' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    strText As String, strFont As String, dblInitialSize As Double, dblAvailableWidth As Double
' Returns:       Double
' Description:   Shrinks text until it fits inside the fixed PDF cell width.
'-------------------------------------------------------------------------------
Private Function FitFontSize( _
    ByVal strText As String, _
    ByVal strFont As String, _
    ByVal dblInitialSize As Double, _
    ByVal dblAvailableWidth As Double) As Double

    Const METHOD_NAME As String = "FitFontSize"
    Dim dblFontSize As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    dblFontSize = dblInitialSize

    Do While dblFontSize > MIN_FONT_SIZE
        If EstimateBase14TextWidth(strText, strFont, dblFontSize) <= dblAvailableWidth Then
            Exit Do
        End If
        dblFontSize = dblFontSize - 0.25
    Loop

    If dblFontSize < MIN_FONT_SIZE Then
        dblFontSize = MIN_FONT_SIZE
    End If

    FitFontSize = dblFontSize

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    FitFontSize = MIN_FONT_SIZE

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    strText As String, strFont As String, dblFontSize As Double
' Returns:       Double
' Description:   Estimates Times-Roman or Times-Bold text width in PDF points.
'-------------------------------------------------------------------------------
Private Function EstimateBase14TextWidth( _
    ByVal strText As String, _
    ByVal strFont As String, _
    ByVal dblFontSize As Double) As Double

    Const METHOD_NAME As String = "EstimateBase14TextWidth"
    Dim dblUnits As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngChar As Long
    Dim lngIndex As Long
    Dim strChar As String

    On Error GoTo ErrorHandler

    dblUnits = 0#

    For lngIndex = 1 To Len(strText)
        strChar = Mid$(strText, lngIndex, 1)
        lngChar = AscW(strChar)

        If strFont = "/F0" Then
            Select Case strChar
                Case " ": dblUnits = dblUnits + 250
                Case "I": dblUnits = dblUnits + 389
                Case "J": dblUnits = dblUnits + 500
                Case "M": dblUnits = dblUnits + 944
                Case "W": dblUnits = dblUnits + 1000
                Case "A", "D", "N", "R", "X", "Y": dblUnits = dblUnits + 722
                Case "B", "E", "L", "T", "Z": dblUnits = dblUnits + 667
                Case "C", "G", "H", "K", "O": dblUnits = dblUnits + 778
                Case "F", "P": dblUnits = dblUnits + 611
                Case "S": dblUnits = dblUnits + 556
                Case "i", "l": dblUnits = dblUnits + 278
                Case "j", "f", "t": dblUnits = dblUnits + 333
                Case "m": dblUnits = dblUnits + 833
                Case "w": dblUnits = dblUnits + 722
                Case "r", "z": dblUnits = dblUnits + 444
                Case "c", "s": dblUnits = dblUnits + 389
                Case "a", "g", "o", "v", "x", "y": dblUnits = dblUnits + 500
                Case "b", "d", "e", "h", "k", "n", "p", "q", "u": dblUnits = dblUnits + 556
                Case "0" To "9": dblUnits = dblUnits + 500
                Case ".", ",": dblUnits = dblUnits + 250
                Case "-": dblUnits = dblUnits + 333
                Case "/": dblUnits = dblUnits + 278
                Case "("
                    dblUnits = dblUnits + 333
                Case ")"
                    dblUnits = dblUnits + 333
                Case Else
                    dblUnits = dblUnits + IIf(lngChar >= 0 And lngChar <= 127, 500, 556)
            End Select
        Else
            Select Case strChar
                Case " ": dblUnits = dblUnits + 250
                Case "I": dblUnits = dblUnits + 333
                Case "J": dblUnits = dblUnits + 389
                Case "M": dblUnits = dblUnits + 889
                Case "W": dblUnits = dblUnits + 944
                Case "A", "D", "G", "H", "K", "N", "O", "Q", "U", "V", "X", "Y": dblUnits = dblUnits + 722
                Case "B", "C", "R": dblUnits = dblUnits + 667
                Case "E", "L", "Z", "T": dblUnits = dblUnits + 611
                Case "F", "P", "S": dblUnits = dblUnits + 556
                Case "i", "j", "l", "t": dblUnits = dblUnits + 278
                Case "f", "r": dblUnits = dblUnits + 333
                Case "m": dblUnits = dblUnits + 778
                Case "w": dblUnits = dblUnits + 722
                Case "s": dblUnits = dblUnits + 389
                Case "a", "c", "z": dblUnits = dblUnits + 444
                Case "b", "d", "e", "g", "h", "k", "n", "o", "p", "q", "u", "v", "x", "y": dblUnits = dblUnits + 500
                Case "0" To "9": dblUnits = dblUnits + 500
                Case ".", ",": dblUnits = dblUnits + 250
                Case "-": dblUnits = dblUnits + 333
                Case "/": dblUnits = dblUnits + 278
                Case "("
                    dblUnits = dblUnits + 333
                Case ")"
                    dblUnits = dblUnits + 333
                Case Else
                    dblUnits = dblUnits + IIf(lngChar >= 0 And lngChar <= 127, 500, 500)
            End Select
        End If
    Next lngIndex

    EstimateBase14TextWidth = (dblUnits / 1000#) * dblFontSize

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    EstimateBase14TextWidth = Len(strText) * dblFontSize * 0.5

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    strFont As String, dblFontSize As Double, dblX As Double, dblY As Double, strText As String
' Returns:       String
' Description:   Builds one simple BT-TD-Tj-ET text command.
'-------------------------------------------------------------------------------
Private Function BuildAbsoluteTextCommand( _
    ByVal strFont As String, _
    ByVal dblFontSize As Double, _
    ByVal dblX As Double, _
    ByVal dblY As Double, _
    ByVal strText As String) As String

    Const METHOD_NAME As String = "BuildAbsoluteTextCommand"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    ' FIX36 / V19:
    ' The BETTER-PARSING PDF uses the compact BT/Tf/Td/Tj/ET text pattern.
    ' Td gives the same text placement as TD when each text object starts with
    ' a fresh text matrix, but unlike TD it does not overwrite text leading TL.
    ' Do not emit redundant Tr/Tc/Tw/Tz/Ts resets before every field; those
    ' operators were a CURRENT-only local stream difference in the V19 audit.
    ' Page graphics start in black and this generator does not set a non-default
    ' text rendering mode elsewhere, so visible output remains unchanged.
    BuildAbsoluteTextCommand = _
        "BT " & _
        strFont & " " & PdfNumber(dblFontSize) & " Tf " & _
        PdfNumber(dblX) & " " & PdfNumber(dblY) & " Td (" & _
        EncodePdfText(strText) & ") Tj ET" & vbCrLf

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildAbsoluteTextCommand = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "font;fontSize;x;y", _
        strFont, _
        dblFontSize, _
        dblX, _
        dblY

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    lngPage As Long, lngPageCount As Long
' Returns:       String
' Description:   Builds the Oracle Reports page number as three text-show operations in one text object.
