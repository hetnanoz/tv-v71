'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    rngSource As Excel.Range
' Returns:       String
' Description:   Returns the displayed worksheet value used by the existing report.
'-------------------------------------------------------------------------------
Private Function GetWorksheetDisplayText(ByVal rngSource As Excel.Range) As String

    Const METHOD_NAME As String = "GetWorksheetDisplayText"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngValue As Excel.Range
    Dim strText As String

    On Error GoTo ErrorHandler

    GetWorksheetDisplayText = vbNullString

    If rngSource Is Nothing Then
        GoTo ExitFunction
    End If

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    If IsError(rngValue.Value) Or IsEmpty(rngValue.Value) Then
        GoTo ExitFunction
    End If

    strText = CStr(rngValue.Text)

    If Len(strText) = 0 Or Replace(strText, "#", vbNullString) = vbNullString Then
        If IsDate(rngValue.Value) Then
            strText = Format$(CDate(rngValue.Value), "dd-mm-yy")
        Else
            strText = CStr(rngValue.Value)
        End If
    End If

    strText = Replace(strText, vbCr, " ")
    strText = Replace(strText, vbLf, " ")
    strText = Replace(strText, ChrW(160), " ")
    strText = RTrim$(strText)

    If Len(Trim$(strText)) = 0 Then
        strText = vbNullString
    End If

    GetWorksheetDisplayText = strText

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GetWorksheetDisplayText = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    rngSource As Excel.Range, strText As String, lngAlignment As Long
' Returns:       String
' Description:   Reproduces Oracle Reports fixed-field padding for right-aligned numeric data.
'-------------------------------------------------------------------------------
Private Function ApplyOracleNumericFieldPadding( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String, _
    ByVal lngAlignment As Long, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As String

    Const METHOD_NAME As String = "ApplyOracleNumericFieldPadding"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngLeadingSpaces As Long
    Dim rngValue As Excel.Range
    Dim strCoreText As String
    Dim strTrailingText As String

    On Error GoTo ErrorHandler

    ApplyOracleNumericFieldPadding = strText

    If Len(strText) = 0 Or lngAlignment <> xlRight Then
        GoTo ExitFunction
    End If

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    If IsDate(rngValue.Value) Or Not IsNumeric(rngValue.Value) Then
        GoTo ExitFunction
    End If

    ' Preserve any deliberate trailing whitespace supplied by the Oracle
    ' display formatter. Current FIX25 does not add numeric trailing spaces.
    strTrailingText = vbNullString
    Do While Len(strText) > 0 And Right$(strText, 1) = " "
        strTrailingText = strTrailingText & " "
        strText = Left$(strText, Len(strText) - 1)
    Loop

    strCoreText = LTrim$(strText)

    If Len(strCoreText) = 0 Then
        GoTo ExitFunction
    End If

    lngLeadingSpaces = ResolveOracleNumericLeadingSpaces( _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strCoreText)

    ApplyOracleNumericFieldPadding = _
        Space$(lngLeadingSpaces) & strCoreText & strTrailingText

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ApplyOracleNumericFieldPadding = strText

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "alignment;topTransactionRow;fieldIndex;text", _
        lngAlignment, _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    rngSource As Excel.Range, strText As String, blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       Long
' Description:   Resolves Oracle data alignment; all Whg fields are centered.
'-------------------------------------------------------------------------------
Private Function ResolveOracleDataAlignment( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As Long

    Const METHOD_NAME As String = "ResolveOracleDataAlignment"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    If Not blnTopTransactionRow And _
       lngFieldIndex = BOTTOM_FIELD_WHG_ABWICKLUNG_INDEX Then

        ResolveOracleDataAlignment = xlRight
    ElseIf IsOracleCurrencyField( _
        blnTopTransactionRow, _
        lngFieldIndex) Then

        ResolveOracleDataAlignment = xlCenter
    Else
        ResolveOracleDataAlignment = ResolveCellAlignment( _
            rngSource, _
            strText)
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveOracleDataAlignment = ResolveCellAlignment(rngSource, strText)

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topTransactionRow;fieldIndex;text", _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       Boolean
' Description:   Identifies Oracle Whg data fields in both transaction rows.
'-------------------------------------------------------------------------------
Private Function IsOracleCurrencyField( _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As Boolean

    Const METHOD_NAME As String = "IsOracleCurrencyField"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    IsOracleCurrencyField = False

    If blnTopTransactionRow Then
        IsOracleCurrencyField = (lngFieldIndex = TOP_FIELD_WHG_INDEX)
    Else
        Select Case lngFieldIndex
            Case BOTTOM_FIELD_WHG_MAKLER_INDEX, _
                 BOTTOM_FIELD_WHG_STEUERN_INDEX, _
                 BOTTOM_FIELD_WHG_ABWICKLUNG_INDEX, _
                 BOTTOM_FIELD_WHG_SPESEN_INDEX, _
                 BOTTOM_FIELD_WHG_ABRECH_INDEX

                IsOracleCurrencyField = True
        End Select
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsOracleCurrencyField = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topTransactionRow;fieldIndex", _
        blnTopTransactionRow, _
        lngFieldIndex

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    blnTopTransactionRow As Boolean, lngFieldIndex As Long, strCurrency As String
' Returns:       Double
' Description:   Applies the small repeatable Oracle Reports currency-anchor
'                residuals measured by V12 after font family/size were matched.
'-------------------------------------------------------------------------------
Private Function ResolveOracleCurrencyTextXCorrection( _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long, _
    ByVal strCurrency As String) As Double

    Const METHOD_NAME As String = "ResolveOracleCurrencyTextXCorrection"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strCode As String

    On Error GoTo ErrorHandler

    ResolveOracleCurrencyTextXCorrection = 0#
    strCode = UCase$(Trim$(strCurrency))

    If blnTopTransactionRow Then
        If lngFieldIndex = TOP_FIELD_WHG_INDEX Then
            ResolveOracleCurrencyTextXCorrection = _
                OracleEightPointWhgCorrection(strCode)
        End If
    Else
        Select Case lngFieldIndex
            Case BOTTOM_FIELD_WHG_MAKLER_INDEX
                Select Case strCode
                    Case "EUR"
                        ResolveOracleCurrencyTextXCorrection = -0.02
                    Case "GBP", "CHF"
                        ResolveOracleCurrencyTextXCorrection = -0.27
                    Case "SEK"
                        ResolveOracleCurrencyTextXCorrection = 0.24
                    Case "DKK", "NOK"
                        ResolveOracleCurrencyTextXCorrection = -0.39
                    Case "INR", "IDR"
                        ResolveOracleCurrencyTextXCorrection = -0.15
                    Case "PHP"
                        ResolveOracleCurrencyTextXCorrection = -0.41
                    Case "THB"
                        ResolveOracleCurrencyTextXCorrection = -0.38
                    Case "BRL"
                        ResolveOracleCurrencyTextXCorrection = 0.09
                End Select

            Case BOTTOM_FIELD_WHG_ABWICKLUNG_INDEX
                Select Case strCode
                    Case "INR", "IDR"
                        ResolveOracleCurrencyTextXCorrection = -0.14
                    Case "PHP"
                        ResolveOracleCurrencyTextXCorrection = 0.15
                End Select

            Case BOTTOM_FIELD_WHG_SPESEN_INDEX
                Select Case strCode
                    Case "GBP"
                        ResolveOracleCurrencyTextXCorrection = -0.25
                    Case "EUR"
                        ResolveOracleCurrencyTextXCorrection = 0#
                    Case "PHP"
                        ResolveOracleCurrencyTextXCorrection = -0.39
                    Case "THB"
                        ResolveOracleCurrencyTextXCorrection = -0.36
                    Case "IDR"
                        ResolveOracleCurrencyTextXCorrection = -0.13
                    Case "BRL"
                        ResolveOracleCurrencyTextXCorrection = 0.11
                End Select

            Case BOTTOM_FIELD_WHG_ABRECH_INDEX
                ResolveOracleCurrencyTextXCorrection = _
                    OracleEightPointWhgCorrection(strCode)
        End Select
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveOracleCurrencyTextXCorrection = 0#

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topTransactionRow;fieldIndex;currency", _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strCurrency

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    strCurrency As String
' Returns:       Double
' Description:   Returns the shared correction for the two 27 pt / 8 pt Whg
'                cells: TOP Whg Nominale and BOTTOM Whg Abrech.
'-------------------------------------------------------------------------------
Private Function OracleEightPointWhgCorrection( _
    ByVal strCurrency As String) As Double

    Const METHOD_NAME As String = "OracleEightPointWhgCorrection"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    OracleEightPointWhgCorrection = 0#

    Select Case UCase$(Trim$(strCurrency))
        Case "EUR"
            OracleEightPointWhgCorrection = -0.26
        Case "GBP", "CHF"
            OracleEightPointWhgCorrection = -0.08
        Case "SEK"
            OracleEightPointWhgCorrection = 0.06
        Case "DKK", "NOK"
            OracleEightPointWhgCorrection = -0.32
        Case "INR", "IDR"
            OracleEightPointWhgCorrection = -0.25
        Case "PHP"
            OracleEightPointWhgCorrection = -0.92
        Case "THB"
            OracleEightPointWhgCorrection = -0.62
        Case "BRL"
            ' FIX33: V13/FIX32 audit showed NEW remained +0.16 pt because
            ' the previous +0.08 correction used the wrong sign.
            OracleEightPointWhgCorrection = -0.08
    End Select

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    OracleEightPointWhgCorrection = 0#

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "currency", _
        strCurrency

    errorManager.save
    Resume ExitFunction
End Function


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    rngSource As Excel.Range, strText As String
' Returns:       Long
' Description:   Resolves the visual alignment used for one report value.
'-------------------------------------------------------------------------------
Private Function ResolveCellAlignment( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String) As Long

    Const METHOD_NAME As String = "ResolveCellAlignment"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAlignment As Long
    Dim rngValue As Excel.Range

    On Error GoTo ErrorHandler

    ResolveCellAlignment = xlLeft

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    lngAlignment = CLng(rngValue.HorizontalAlignment)

    If lngAlignment = xlCenter Or lngAlignment = xlRight Or lngAlignment = xlLeft Then
        ResolveCellAlignment = lngAlignment
        GoTo ExitFunction
    End If

    If IsDate(rngValue.Value) Then
        ResolveCellAlignment = xlCenter
    ElseIf IsNumeric(rngValue.Value) And Len(strText) > 0 Then
        ResolveCellAlignment = xlRight
    ElseIf Len(strText) = 3 And UCase$(strText) = strText And strText Like "[A-Z][A-Z][A-Z]" Then
        ResolveCellAlignment = xlCenter
    Else
        ResolveCellAlignment = xlLeft
    End If

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveCellAlignment = xlLeft

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-10
' Parameters:    blnTopTransactionRow As Boolean, lngFieldIndex As Long
