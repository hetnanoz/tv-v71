' Description:   Identifies fields whose integer part uses Oracle space grouping.
'-------------------------------------------------------------------------------

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-10
' Parameters:    strText As String
' Returns:       String
' Description:   Removes the integer zero before a decimal separator for
'                non-zero fractional values, matching Oracle number pictures.
'-------------------------------------------------------------------------------
Private Function SuppressOracleFractionLeadingZero( _
    ByVal strText As String) As String

    Const METHOD_NAME As String = "SuppressOracleFractionLeadingZero"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strSign As String
    Dim strWorking As String

    On Error GoTo ErrorHandler

    SuppressOracleFractionLeadingZero = strText
    strWorking = Trim$(strText)

    If Len(strWorking) = 0 Then
        GoTo ExitFunction
    End If

    If Left$(strWorking, 1) = "-" Or Left$(strWorking, 1) = "+" Then
        strSign = Left$(strWorking, 1)
        strWorking = Mid$(strWorking, 2)
    End If

    If Len(strWorking) >= 2 Then
        If Left$(strWorking, 2) = "0." Or _
           Left$(strWorking, 2) = "0," Then

            strWorking = Mid$(strWorking, 2)
        End If
    End If

    SuppressOracleFractionLeadingZero = strSign & strWorking

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    SuppressOracleFractionLeadingZero = strText

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "text", _
        strText

    errorManager.save
    Resume ExitFunction
End Function

