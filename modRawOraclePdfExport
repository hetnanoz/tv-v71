        Case Else
            IsVisibleRectanglePaintOperator = False
    End Select

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsVisibleRectanglePaintOperator = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "operator", _
        strOperator

    errorManager.save
    Resume ExitFunction
End Function
