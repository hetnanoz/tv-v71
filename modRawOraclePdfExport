'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long, blnHasLogo As Boolean, colPageContents As Collection
' Returns:       Boolean
' Description:   Builds every page and resolves report-wide Storno behavior once.
'-------------------------------------------------------------------------------
Private Function BuildAllPageContents( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByVal lngTradeCount As Long, _
    ByVal blnHasLogo As Boolean, _
    ByRef colPageContents As Collection) As Boolean

    Const METHOD_NAME As String = "BuildAllPageContents"
    Dim blnStornoReport As Boolean
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngPage As Long
    Dim lngPageCount As Long
    Dim strPageContent As String

    On Error GoTo ErrorHandler

    BuildAllPageContents = False
    Set colPageContents = New Collection

    If lngTradeCount <= 0 Then
        Err.Raise 1001, METHOD_NAME, "At least one transaction is required."
    End If

    lngPageCount = GetOraclePageCount(lngTradeCount)
    blnStornoReport = ReportContainsStornoTransactions( _
        wksSource, _
        arrTopRows, _
        lngTradeCount)

    For lngPage = 1 To lngPageCount
        strPageContent = BuildSinglePageContent( _
            wksSource, _
            arrTopRows, _
            arrBottomRows, _
            lngTradeCount, _
            lngPage, _
            lngPageCount, _
            blnHasLogo, _
            blnStornoReport)

        If Len(strPageContent) = 0 Then
            Err.Raise 1024, METHOD_NAME, "A page content stream was empty."
        End If

        colPageContents.Add strPageContent
    Next lngPage

    BuildAllPageContents = (colPageContents.Count = lngPageCount)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildAllPageContents = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "tradeCount;pageCount", _
        lngTradeCount, _
        lngPageCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-10
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, lngTradeCount As Long
' Returns:       Boolean
' Description:   Returns whether the report contains at least one Storno transaction.
'-------------------------------------------------------------------------------
Private Function ReportContainsStornoTransactions( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByVal lngTradeCount As Long) As Boolean

    Const METHOD_NAME As String = "ReportContainsStornoTransactions"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strTransactionType As String

    On Error GoTo ErrorHandler

    ReportContainsStornoTransactions = False

    If wksSource Is Nothing Or lngTradeCount <= 0 Then
        GoTo ExitFunction
    End If

    For lngIndex = LBound(arrTopRows) To UBound(arrTopRows)
        strTransactionType = UCase$(Trim$(GetWorksheetDisplayText( _
            wksSource.Cells(arrTopRows(lngIndex), 5))))

        If strTransactionType = "STORNO" Or _
           Left$(strTransactionType, 7) = "STORNO " Then

            ReportContainsStornoTransactions = True
            Exit For
        End If
    Next lngIndex

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ReportContainsStornoTransactions = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "tradeCount", _
        lngTradeCount

    errorManager.save
    Resume ExitFunction
End Function

