'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long, lngPage As Long, lngPageCount As Long, blnHasLogo As Boolean, blnStornoReport As Boolean
' Returns:       String
' Description:   Builds one page using fixed Oracle geometry and semantic font roles.
'-------------------------------------------------------------------------------
Private Function BuildSinglePageContent( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByVal lngTradeCount As Long, _
    ByVal lngPage As Long, _
    ByVal lngPageCount As Long, _
    ByVal blnHasLogo As Boolean, _
    ByVal blnStornoReport As Boolean) As String

    Const METHOD_NAME As String = "BuildSinglePageContent"
    Dim arrBottomColumns As Variant
    Dim arrBottomDataTextX As Variant
    Dim arrBottomHeaderLabels As Variant
    Dim arrBottomHeaderTextX As Variant
    Dim arrBottomWidths As Variant
    Dim arrBottomX As Variant
    Dim arrTopColumns As Variant
    Dim arrTopDataTextX As Variant
    Dim arrTopHeaderLabels As Variant
    Dim arrTopHeaderTextX As Variant
    Dim arrTopWidths As Variant
    Dim arrTopX As Variant
    Dim blnDrawSeparatorBottom As Boolean
    Dim blnDrawTradeTop As Boolean
    Dim blnFirstPage As Boolean
    Dim blnLastPage As Boolean
    Dim dblBottomBaseline As Double
    Dim dblBottomRowY As Double
    Dim dblHeaderBottomY As Double
    Dim dblHeaderTopY As Double
    Dim dblSeparatorY As Double
    Dim dblTableBottomY As Double
    Dim dblTableTopY As Double
    Dim dblTopBaseline As Double
    Dim dblTopRowTopY As Double
    Dim dblTopRowY As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFirstTrade As Long
    Dim lngLastTrade As Long
    Dim lngSlot As Long
    Dim lngTradeIndex As Long
    Dim strContent As String
    Dim strFooterFont As String

    On Error GoTo ErrorHandler

    BuildSinglePageContent = vbNullString

    blnFirstPage = (lngPage = 1)
    blnLastPage = (lngPage = lngPageCount)

    Call GetOraclePageTradeBounds( _
        lngTradeCount, _
        lngPage, _
        lngFirstTrade, _
        lngLastTrade)

    arrTopX = GetTopGridX()
    arrTopWidths = GetTopGridWidths()
    arrBottomX = GetBottomGridX()
    arrBottomWidths = GetBottomGridWidths()
    arrTopColumns = GetTopSourceColumns()
    arrBottomColumns = GetBottomSourceColumns()
    arrTopDataTextX = GetTopDataTextX()
    arrBottomDataTextX = GetBottomDataTextX()
    arrTopHeaderTextX = GetTopHeaderTextX()
    arrBottomHeaderTextX = GetBottomHeaderTextX()
    arrTopHeaderLabels = GetTopHeaderLabels()
    arrBottomHeaderLabels = GetBottomHeaderLabels()

    If blnFirstPage Then
        dblHeaderTopY = FIRST_PAGE_HEADER_TOP_Y
        dblHeaderBottomY = FIRST_PAGE_HEADER_BOTTOM_Y
        dblTableTopY = FIRST_PAGE_TABLE_TOP_Y
    Else
        dblHeaderTopY = CONTINUATION_PAGE_HEADER_TOP_Y
        dblHeaderBottomY = CONTINUATION_PAGE_HEADER_BOTTOM_Y
        dblTableTopY = CONTINUATION_PAGE_TABLE_TOP_Y
    End If

    strContent = "0 g" & vbCrLf & "0 w" & vbCrLf

    If blnFirstPage And blnHasLogo Then
        strContent = strContent & _
            "q" & vbCrLf & _
            PdfNumber(LOGO_WIDTH) & " 0 0 " & PdfNumber(LOGO_HEIGHT) & " " & _
            PdfNumber(LOGO_X) & " " & PdfNumber(LOGO_Y) & " cm" & vbCrLf & _
            "/Im0 Do" & vbCrLf & _
            "Q" & vbCrLf
    End If

    strContent = strContent & BuildOracleHeaderStructure( _
        arrTopX, _
        arrBottomX, _
        dblHeaderBottomY, _
        dblHeaderTopY, _
        dblTableTopY, _
        IIf(blnFirstPage, 540#, 594#))

    strContent = strContent & BuildGridRowContent( _
        wksSource, _
        5, _
        arrTopColumns, _
        arrTopX, _
        arrTopWidths, _
        dblHeaderTopY, _
        IIf(blnFirstPage, 540.76, 594.76), _
        True, _
        arrTopHeaderTextX, _
        arrTopHeaderLabels, _
        lngOracleClipRow:=ORACLE_CLIP_ROW_HEADER_TOP)

    strContent = strContent & BuildGridRowContent( _
        wksSource, _
        6, _
        arrBottomColumns, _
        arrBottomX, _
        arrBottomWidths, _
        dblHeaderBottomY, _
        IIf(blnFirstPage, 522.76, 576.76), _
        True, _
        arrBottomHeaderTextX, _
        arrBottomHeaderLabels, _
        lngOracleClipRow:=ORACLE_CLIP_ROW_HEADER_BOTTOM)

    lngSlot = 0

    For lngTradeIndex = lngFirstTrade To lngLastTrade
        lngSlot = lngSlot + 1
        dblTopBaseline = GetTransactionTopBaseline(blnFirstPage, lngSlot)
        dblBottomBaseline = dblTopBaseline - DATA_ROW_HEIGHT
        dblTopRowTopY = GetTransactionTopRowTopY(blnFirstPage, lngSlot)
        dblTopRowY = GetTransactionTopRowBottomY(blnFirstPage, lngSlot)
        dblBottomRowY = GetTransactionBottomRowBottomY(blnFirstPage, lngSlot)
        dblSeparatorY = GetTransactionSeparatorBottomY(blnFirstPage, lngSlot)
        blnDrawTradeTop = (lngSlot > 1)
        blnDrawSeparatorBottom = (lngTradeIndex < lngLastTrade)

        strContent = strContent & BuildOracleTransactionStructure( _
            arrTopX, _
            arrBottomX, _
            dblTopBaseline, _
            dblBottomBaseline, _
            dblTopRowTopY, _
            dblTopRowY, _
            dblBottomRowY, _
            dblSeparatorY, _
            blnDrawTradeTop, _
            blnDrawSeparatorBottom)

        strContent = strContent & BuildGridRowContent( _
            wksSource, _
            arrTopRows(lngTradeIndex), _
            arrTopColumns, _
            arrTopX, _
            arrTopWidths, _
            dblTopRowY, _
            dblTopBaseline, _
            False, _
            varFixedTextX:=arrTopDataTextX, _
            blnTopTransactionRow:=True, _
            lngOracleClipRow:=ORACLE_CLIP_ROW_TRANSACTION_TOP)

        strContent = strContent & BuildGridRowContent( _
            wksSource, _
            arrBottomRows(lngTradeIndex), _
            arrBottomColumns, _
            arrBottomX, _
            arrBottomWidths, _
            dblBottomRowY, _
            dblBottomBaseline, _
            False, _
            arrBottomDataTextX, _
            lngOracleClipRow:=ORACLE_CLIP_ROW_TRANSACTION_BOTTOM)
    Next lngTradeIndex

    dblTableBottomY = dblSeparatorY

    strContent = strContent & BuildStrokedRectangleCommand( _
        TABLE_LEFT_X, _
        dblTableBottomY, _
        TABLE_WIDTH, _
        dblTableTopY - dblTableBottomY)

    If blnLastPage Then
        strFooterFont = ResolveOracleFooterFont(blnStornoReport)

        strContent = strContent & BuildAbsoluteTextCommand( _
            strFooterFont, _
            FOOTER_FONT_SIZE, _
            FOOTER_X, _
            dblTableBottomY - FOOTER_BASELINE_GAP, _
            FOOTER_TEXT)
    End If

    strContent = strContent & BuildPageNumberCommand( _
        lngPage, _
        lngPageCount)

    If Not ValidateOracleParserSensitivePageContent(strContent, lngPage) Then
        Err.Raise 1024, METHOD_NAME, _
            "The raw page stream failed the X=468/X=639 Oracle parser-safety validation."
    End If

    BuildSinglePageContent = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildSinglePageContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "page;pageCount;firstTrade;lastTrade;stornoReport", _
        lngPage, _
        lngPageCount, _
        lngFirstTrade, _
        lngLastTrade, _
        blnStornoReport

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    wksSource As Excel.Worksheet, lngSourceRow As Long, arrSourceColumns As Variant, arrX As Variant, arrWidths As Variant, dblRowY As Double, dblBaselineY As Double, blnHeader As Boolean, varFixedTextX As Variant, varFixedTextValues As Variant, blnTopTransactionRow As Boolean, lngOracleClipRow As Long
' Returns:       String
' Description:   Builds text for one fixed Oracle upper or lower report row.
'-------------------------------------------------------------------------------
Private Function BuildGridRowContent( _
    ByVal wksSource As Excel.Worksheet, _
    ByVal lngSourceRow As Long, _
    ByVal arrSourceColumns As Variant, _
    ByVal arrX As Variant, _
    ByVal arrWidths As Variant, _
    ByVal dblRowY As Double, _
    ByVal dblBaselineY As Double, _
    ByVal blnHeader As Boolean, _
    Optional ByVal varFixedTextX As Variant, _
    Optional ByVal varFixedTextValues As Variant, _
    Optional ByVal blnTopTransactionRow As Boolean = False, _
    Optional ByVal lngOracleClipRow As Long = 0) As String

    Const METHOD_NAME As String = "BuildGridRowContent"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim dblFixedTextX As Double
    Dim lngIndex As Long
    Dim rngSource As Excel.Range
    Dim strContent As String
    Dim strOverrideText As String

    On Error GoTo ErrorHandler

    BuildGridRowContent = vbNullString

    If UBound(arrSourceColumns) <> UBound(arrX) Or UBound(arrX) <> UBound(arrWidths) Then
        Err.Raise 1024, METHOD_NAME, "The row geometry arrays do not have matching dimensions."
    End If

    If Not IsMissing(varFixedTextX) Then
        If Not IsArray(varFixedTextX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text anchor configuration is not an array."
        End If
        If UBound(varFixedTextX) <> UBound(arrX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text anchor array does not match the row geometry."
        End If
    End If

    If Not IsMissing(varFixedTextValues) Then
        If Not IsArray(varFixedTextValues) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text value configuration is not an array."
        End If
        If UBound(varFixedTextValues) <> UBound(arrX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text value array does not match the row geometry."
        End If
    End If

    For lngIndex = LBound(arrX) To UBound(arrX)
        Set rngSource = wksSource.Cells(lngSourceRow, CLng(arrSourceColumns(lngIndex)))

        dblFixedTextX = -1#
        If Not IsMissing(varFixedTextX) Then
            dblFixedTextX = CDbl(varFixedTextX(lngIndex))
        End If

        strOverrideText = vbNullString
        If Not IsMissing(varFixedTextValues) Then
            strOverrideText = CStr(varFixedTextValues(lngIndex))
        End If

        strContent = strContent & BuildCellContent( _
            rngSource, _
            CDbl(arrX(lngIndex)), _
            dblRowY, _
            CDbl(arrWidths(lngIndex)), _
            DATA_ROW_HEIGHT, _
            dblBaselineY, _
            blnHeader, _
            dblFixedTextX, _
            strOverrideText, _
            blnTopTransactionRow, _
            lngIndex, _
            lngOracleClipRow)
    Next lngIndex

    BuildGridRowContent = strContent

ExitFunction:
    Set rngSource = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildGridRowContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "sourceRow;rowY;baselineY;header", _
        lngSourceRow, _
        dblRowY, _
        dblBaselineY, _
        blnHeader

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    rngSource As Excel.Range, dblX As Double, dblY As Double, dblWidth As Double, dblHeight As Double, dblBaselineY As Double, blnHeader As Boolean, dblFixedTextX As Double, strOverrideText As String, blnTopTransactionRow As Boolean, lngFieldIndex As Long, lngOracleClipRow As Long
' Returns:       String
' Description:   Builds one Oracle-compatible text run from a worksheet cell or fixed header label.
'-------------------------------------------------------------------------------
Private Function BuildCellContent( _
    ByVal rngSource As Excel.Range, _
    ByVal dblX As Double, _
    ByVal dblY As Double, _
    ByVal dblWidth As Double, _
    ByVal dblHeight As Double, _
    ByVal dblBaselineY As Double, _
    ByVal blnHeader As Boolean, _
    Optional ByVal dblFixedTextX As Double = -1#, _
    Optional ByVal strOverrideText As String = vbNullString, _
    Optional ByVal blnTopTransactionRow As Boolean = False, _
    Optional ByVal lngFieldIndex As Long = -1, _
    Optional ByVal lngOracleClipRow As Long = 0) As String

    Const METHOD_NAME As String = "BuildCellContent"
    Const FONT_SIZE_TOLERANCE As Double = 0.01
    Const ORACLE_EIGHT_PT_BASELINE_OFFSET As Double = 0.76
    Dim dblEffectiveRightPadding As Double
    Dim dblFontSize As Double
    Dim dblMeasurementFontSize As Double
    Dim dblTextWidth As Double
    Dim dblTextX As Double
    Dim dblTextY As Double
    Dim errorManager As New ErrorManager
    Dim lngOracleClipDepth As Long
    Dim strClipClose As String
    Dim strClipOpen As String
    Dim strTextCommand As String
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAlignment As Long
    Dim strFont As String
    Dim strText As String

    On Error GoTo ErrorHandler

    BuildCellContent = vbNullString

    If blnHeader And Len(strOverrideText) > 0 Then
        strText = strOverrideText
    Else
        strText = GetWorksheetDisplayText(rngSource)
    End If

    If blnHeader Then
        strFont = "/F0"
        dblFontSize = HEADER_FONT_SIZE
        lngAlignment = xlCenter
    Else
        strText = NormalizeOracleFieldDisplayText( _
            rngSource, _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)

        strFont = ResolveOracleDataFontResource( _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)

        dblFontSize = ResolveOracleDataFontSize( _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)

        dblFixedTextX = ResolveOracleFixedDataTextX( _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex, _
            dblFixedTextX)

        lngAlignment = ResolveOracleDataAlignment( _
            rngSource, _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)

        strText = ApplyOracleNumericFieldPadding( _
            rngSource, _
            strText, _
            lngAlignment, _
            blnTopTransactionRow, _
            lngFieldIndex)
    End If

    ' FIX37A PART 1:
    ' OLD Oracle activates rectangular clipping before the affected text runs.
    ' Resolve the clip stack before the empty-text exit so the structural clip
    ' rectangle is still serialized even when the worksheet value is blank.
    strClipOpen = BuildOracleCellClipOpenContent( _
        lngOracleClipRow, _
        lngFieldIndex, _
        dblBaselineY, _
        (Len(strText) > 0), _
        lngOracleClipDepth)

    ' FIX39:
    ' Blueprint V3 proved that OLD Oracle does not use empty literals for the
    ' blank numeric fields that sit inside active cell clips. It emits a
    ' whitespace-only Tj run (five spaces at 9 pt), which is parser-visible
    ' even though the page looks blank. Preserve that occupancy exactly.
    '
    ' Truly unclipped blank cells remain silent. WKN is not synthesized here;
    ' it is restored in modTradeversand from the input header and its clip is
    ' decided later from the actual rendered width.
    If Len(strText) = 0 And lngOracleClipDepth = 0 Then
        GoTo ExitFunction
    End If

    If Len(strText) = 0 And lngOracleClipDepth > 0 Then
        strText = ResolveOracleBlankClipText( _
            blnHeader, _
            blnTopTransactionRow, _
            lngFieldIndex)
    End If

    dblTextY = dblBaselineY
    dblEffectiveRightPadding = TEXT_RIGHT_PADDING

    If Not blnHeader Then
        dblEffectiveRightPadding = ResolveOracleRightPadding( _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)
    End If

    If blnHeader And dblFixedTextX >= 0# Then
        dblTextX = dblFixedTextX
    Else
        If Not ShouldPreserveOracleDataFontSize( _
            blnHeader, _
            blnTopTransactionRow, _
            lngFieldIndex) Then

            dblFontSize = FitFontSize( _
                strText, _
                strFont, _
                dblFontSize, _
                dblWidth - TEXT_LEFT_PADDING - TEXT_RIGHT_PADDING)
        End If

        dblMeasurementFontSize = ResolveOracleTextMeasurementFontSize( _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex, _
            dblFontSize)

        dblTextWidth = EstimateBase14TextWidth( _
            strText, _
            strFont, _
            dblMeasurementFontSize)

        If dblFixedTextX >= 0# Then
            ' FIX19: parser-audited Oracle data anchor. Only fields with an
            ' explicit old-PDF coordinate use this path; all other data remains
            ' content-dependent and keeps the normal alignment calculation.
            dblTextX = dblFixedTextX
        Else
            Select Case lngAlignment
                Case xlCenter
                    dblTextX = dblX + ((dblWidth - dblTextWidth) / 2#)
                Case xlRight
                    dblTextX = dblX + dblWidth - dblEffectiveRightPadding - dblTextWidth
                Case Else
                    dblTextX = dblX + TEXT_LEFT_PADDING
            End Select
        End If

        If Not blnHeader And _
           dblFixedTextX < 0# And _
           IsOracleCurrencyField( _
               blnTopTransactionRow, _
               lngFieldIndex) Then

            dblTextX = dblTextX + _
                ResolveOracleCurrencyTextXCorrection( _
                    blnTopTransactionRow, _
                    lngFieldIndex, _
                    strText)
        End If

        If dblTextX < dblX + 0.5 Then
            dblTextX = dblX + 0.5
        End If
    End If

    ' FIX39 WKN overflow rule:
    ' OLD Blueprint V3 shows the WKN clip x=558..589.52 only for a subset of
    ' populated WKNs (34/66 in the reference report), not for every WKN cell.
    ' This is consistent with overflow-driven clipping: keep 9 pt text and
    ' activate the OLD Oracle WKN clip only when the rendered glyph run crosses
    ' the clip box. This also reproduces examples such as A2PTUX being cut by
    ' the right edge instead of being dynamically shrunk.
    If Not blnHeader And _
       blnTopTransactionRow And _
       lngFieldIndex = TOP_FIELD_WKN_INDEX And _
       Len(strText) > 0 And _
       lngOracleClipDepth = 0 Then

        If ShouldUseOracleWknOverflowClip( _
            dblTextX, _
            dblTextWidth) Then

            strClipOpen = BuildOracleClipOpenCommand( _
                ORACLE_WKN_CLIP_X, _
                dblBaselineY - ORACLE_WKN_CLIP_BASELINE_OFFSET, _
                ORACLE_WKN_CLIP_WIDTH, _
                ORACLE_WKN_CLIP_HEIGHT)

            lngOracleClipDepth = 1
        End If
    End If

    ' FIX39 general overflow guard for Wertpapierbezeichnung:
    ' the resolved Oracle font size is kept fixed. Only when the actual text
    ' would cross the logical cell interior do we activate a local clip. Short
    ' descriptions are byte-for-byte unaffected by this branch.
    If Not blnHeader And _
       blnTopTransactionRow And _
       lngFieldIndex = TOP_FIELD_SECURITY_DESCRIPTION_INDEX And _
       Len(strText) > 0 And _
       lngOracleClipDepth = 0 Then

        If ShouldUseOracleCellOverflowClip( _
            dblTextX, _
            dblTextWidth, _
            dblX, _
            dblWidth) Then

            strClipOpen = BuildOracleClipOpenCommand( _
                dblX + TEXT_LEFT_PADDING, _
                dblBaselineY - ORACLE_WKN_CLIP_BASELINE_OFFSET, _
                dblWidth - TEXT_LEFT_PADDING - TEXT_RIGHT_PADDING, _
                ORACLE_WKN_CLIP_HEIGHT)

            lngOracleClipDepth = 1
        End If
    End If

    If lngOracleClipDepth > 0 Then
        strClipClose = BuildOracleClipCloseContent(lngOracleClipDepth)
    End If

    If Not blnHeader Then
        If Abs(dblFontSize - LONG_TEXT_FONT_SIZE) < FONT_SIZE_TOLERANCE Then
            dblTextY = dblBaselineY + ORACLE_EIGHT_PT_BASELINE_OFFSET
        End If
    End If

    strTextCommand = BuildAbsoluteTextCommand( _
        strFont, _
        dblFontSize, _
        dblTextX, _
        dblTextY, _
        strText)

    If lngOracleClipDepth > 0 Then
        BuildCellContent = strClipOpen & strTextCommand & strClipClose
    Else
        BuildCellContent = strTextCommand
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildCellContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "x;y;width;height;header;fixedTextX", _
        dblX, _
        dblY, _
        dblWidth, _
        dblHeight, _
        blnHeader, _
        dblFixedTextX

    errorManager.save
    Resume ExitFunction
End Function


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    arrTopX As Variant, arrBottomX As Variant, dblHeaderBottomY As Double, dblHeaderTopY As Double, dblTableTopY As Double, dblSpecialY As Double
' Returns:       String
' Description:   Builds the Oracle Reports header rectangle and single-stroke vector structure.
'-------------------------------------------------------------------------------
Private Function BuildOracleHeaderStructure( _
    ByVal arrTopX As Variant, _
    ByVal arrBottomX As Variant, _
    ByVal dblHeaderBottomY As Double, _
    ByVal dblHeaderTopY As Double, _
    ByVal dblTableTopY As Double, _
    ByVal dblSpecialY As Double) As String

    Const METHOD_NAME As String = "BuildOracleHeaderStructure"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    strContent = BuildFilledStrokedRectangleCommand( _
        TABLE_LEFT_X, _
        dblHeaderBottomY, _
        TABLE_WIDTH, _
        dblTableTopY - dblHeaderBottomY, _
        HEADER_GRAY_LEVEL)

    ' FIX37A: the former header re n is now emitted as re W n around
    ' the Stueckzinsen header text so the clipping state survives through Tj.

    strContent = strContent & BuildHeaderGridStrokeContent( _
        arrTopX, _
        arrBottomX, _
        dblHeaderBottomY, _
        dblHeaderTopY, _
        dblTableTopY)

    BuildOracleHeaderStructure = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildOracleHeaderStructure = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "headerBottomY;headerTopY;tableTopY;specialY", _
        dblHeaderBottomY, _
        dblHeaderTopY, _
        dblTableTopY, _
        dblSpecialY

