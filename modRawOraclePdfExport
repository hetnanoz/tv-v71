Private Function GetTransactionTopBaseline( _
    ByVal blnFirstPage As Boolean, _
    ByVal lngSlot As Long) As Double

    Const METHOD_NAME As String = "GetTransactionTopBaseline"
    Dim arrValues As Variant
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    If lngSlot < 1 Or lngSlot > GetOracleMaxTransactionsForPage(blnFirstPage) Then
        Err.Raise 1001, METHOD_NAME, "The transaction slot is outside the valid Oracle page capacity."
    End If

    If blnFirstPage Then
        arrValues = Array(504#, 463.48, 423#, 382.48, 342#, 301.48, 261#, 220.48, 180#, 139.48, 99#)
    Else
        arrValues = Array(558#, 517.48, 477#, 436.48, 396#, 355.48, 315#, 274.48, 234#, 193.48, 153#, 112.48)
    End If

    GetTransactionTopBaseline = CDbl(arrValues(lngSlot - 1))

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GetTransactionTopBaseline = 0#

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "firstPage;slot", _
        blnFirstPage, _
        lngSlot

    errorManager.save
    Resume ExitFunction
