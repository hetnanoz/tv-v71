ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildInteriorVerticalLines = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "bottomY;topY", _
        dblBottomY, _
        dblTopY

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrX As Variant, dblBottomY As Double, dblTopY As Double, blnUseTransactionRelativeTargetSpan As Boolean, dblBottomBaseline As Double
' Returns:       String
' Description:   Draws lower/header-bottom vertical rules. For transaction rows,
'                X=468 and X=639 use the exact OLD relative span -4.52..13.48.
'-------------------------------------------------------------------------------
Private Function BuildOracleParserSensitiveBottomVerticalLines( _
    ByVal arrX As Variant, _
    ByVal dblBottomY As Double, _
    ByVal dblTopY As Double, _
    Optional ByVal blnUseTransactionRelativeTargetSpan As Boolean = False, _
    Optional ByVal dblBottomBaseline As Double = 0#) As String

    Const METHOD_NAME As String = "BuildOracleParserSensitiveBottomVerticalLines"
    Dim dblTargetBottomY As Double
    Dim dblTargetTopY As Double
    Dim dblX As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    If Not IsArray(arrX) Then
        Err.Raise 1024, METHOD_NAME, "The X-coordinate configuration is not an array."
    End If

    If dblTopY <= dblBottomY Then
        Err.Raise 1024, METHOD_NAME, "The vertical line span is not positive."
    End If

    For lngIndex = LBound(arrX) + 1 To UBound(arrX)
        dblX = CDbl(arrX(lngIndex))

        If IsOracleParserTargetX(dblX) Then
            If blnUseTransactionRelativeTargetSpan Then
                dblTargetBottomY = _
                    dblBottomBaseline + ORACLE_TARGET_SEPARATOR_REL_BOTTOM
                dblTargetTopY = _
                    dblBottomBaseline + ORACLE_TARGET_SEPARATOR_REL_TOP
            Else
                dblTargetBottomY = dblBottomY
                dblTargetTopY = dblTopY
            End If

            strContent = strContent & BuildOracleTargetSeparatorLineCommand( _
                dblX, _
                dblTargetBottomY, _
                dblTargetTopY)
        Else
            strContent = strContent & BuildLineCommand( _
                dblX, _
                dblBottomY, _
                dblX, _
                dblTopY)
        End If
    Next lngIndex

    BuildOracleParserSensitiveBottomVerticalLines = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildOracleParserSensitiveBottomVerticalLines = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "bottomY;topY;useTransactionRelativeTargetSpan;bottomBaseline", _
        dblBottomY, _
        dblTopY, _
        blnUseTransactionRelativeTargetSpan, _
        dblBottomBaseline

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    dblX As Double
' Returns:       Boolean
' Description:   Identifies the two parser-sensitive lower-grid X coordinates.
'-------------------------------------------------------------------------------
Private Function IsOracleParserTargetX(ByVal dblX As Double) As Boolean
    Const METHOD_NAME As String = "IsOracleParserTargetX"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    IsOracleParserTargetX = _
        (Abs(dblX - ORACLE_PARSER_TARGET_X_FIRST) <= ORACLE_PARSER_TARGET_X_TOLERANCE) Or _
        (Abs(dblX - ORACLE_PARSER_TARGET_X_SECOND) <= ORACLE_PARSER_TARGET_X_TOLERANCE)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsOracleParserTargetX = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "x", _
        dblX

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    dblX As Double, dblBottomY As Double, dblTopY As Double
' Returns:       String
' Description:   Emits the OLD Oracle primitive literally as x y m x y l S.
'                Never replace this target path with re/S.
'-------------------------------------------------------------------------------
Private Function BuildOracleTargetSeparatorLineCommand( _
    ByVal dblX As Double, _
    ByVal dblBottomY As Double, _
    ByVal dblTopY As Double) As String

    Const METHOD_NAME As String = "BuildOracleTargetSeparatorLineCommand"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    If Not IsOracleParserTargetX(dblX) Then
        Err.Raise 1024, METHOD_NAME, "The requested X is not a parser-sensitive target separator."
    End If

    If dblTopY <= dblBottomY Then
        Err.Raise 1024, METHOD_NAME, "The target separator span is not positive."
    End If

    BuildOracleTargetSeparatorLineCommand = _
        PdfNumber(dblX) & " " & PdfNumber(dblBottomY) & " m " & _
        PdfNumber(dblX) & " " & PdfNumber(dblTopY) & " l S" & vbCrLf

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildOracleTargetSeparatorLineCommand = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "x;bottomY;topY", _
        dblX, _
        dblBottomY, _
        dblTopY

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strContent As String, lngPage As Long
' Returns:       Boolean
' Description:   Checks the actual uncompressed page stream before compression.
'                It rejects visible re-based edges at X=468/X=639 and requires
'                explicit m/l/S target rules. Invisible re n remains allowed.
'-------------------------------------------------------------------------------
Private Function ValidateOracleParserSensitivePageContent( _
    ByVal strContent As String, _
    ByVal lngPage As Long) As Boolean

    Const METHOD_NAME As String = "ValidateOracleParserSensitivePageContent"
    Dim arrLines As Variant
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFirstMlCount As Long
    Dim lngIndex As Long
    Dim lngSecondMlCount As Long
    Dim strLine As String

    On Error GoTo ErrorHandler

    ValidateOracleParserSensitivePageContent = False
    arrLines = Split(strContent, vbCrLf)

    For lngIndex = LBound(arrLines) To UBound(arrLines)
        strLine = Trim$(CStr(arrLines(lngIndex)))

        If Len(strLine) > 0 Then
            If IsOracleTargetMlLine(strLine, ORACLE_PARSER_TARGET_X_FIRST) Then
                lngFirstMlCount = lngFirstMlCount + 1
            End If

            If IsOracleTargetMlLine(strLine, ORACLE_PARSER_TARGET_X_SECOND) Then
                lngSecondMlCount = lngSecondMlCount + 1
            End If

            If VisibleRectangleTouchesOracleTargetX(strLine, ORACLE_PARSER_TARGET_X_FIRST) Then
                Err.Raise 1024, METHOD_NAME, _
                    "Visible re primitive touches X=468 on page " & CStr(lngPage) & "."
            End If

            If VisibleRectangleTouchesOracleTargetX(strLine, ORACLE_PARSER_TARGET_X_SECOND) Then
                Err.Raise 1024, METHOD_NAME, _
                    "Visible re primitive touches X=639 on page " & CStr(lngPage) & "."
            End If
        End If
    Next lngIndex

    If lngFirstMlCount = 0 Or lngSecondMlCount = 0 Then
        Err.Raise 1024, METHOD_NAME, _
            "The page does not contain both parser-sensitive m/l/S separator families."
    End If

    ValidateOracleParserSensitivePageContent = True

    Debug.Print "modRawOraclePdfExport " & RAW_ORACLE_BUILD_SIGNATURE & _
        " | page=" & CStr(lngPage) & _
        " | x468_m/l=" & CStr(lngFirstMlCount) & _
        " | x639_m/l=" & CStr(lngSecondMlCount) & _
        " | visible_re_at_targets=0"

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ValidateOracleParserSensitivePageContent = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "page", _
        lngPage

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strLine As String, dblTargetX As Double
' Returns:       Boolean
' Description:   Detects one explicit vertical m/l/S rule at the requested X.
'-------------------------------------------------------------------------------
Private Function IsOracleTargetMlLine( _
    ByVal strLine As String, _
    ByVal dblTargetX As Double) As Boolean

    Const METHOD_NAME As String = "IsOracleTargetMlLine"
    Dim arrTokens As Variant
    Dim dblX1 As Double
    Dim dblX2 As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    IsOracleTargetMlLine = False
    arrTokens = Split(Trim$(strLine), " ")

    If UBound(arrTokens) < 6 Then GoTo ExitFunction
    If CStr(arrTokens(2)) <> "m" Then GoTo ExitFunction
    If CStr(arrTokens(5)) <> "l" Then GoTo ExitFunction
    If CStr(arrTokens(6)) <> "S" Then GoTo ExitFunction

    dblX1 = Val(CStr(arrTokens(0)))
    dblX2 = Val(CStr(arrTokens(3)))

    IsOracleTargetMlLine = _
        Abs(dblX1 - dblTargetX) <= ORACLE_PARSER_TARGET_X_TOLERANCE And _
        Abs(dblX2 - dblTargetX) <= ORACLE_PARSER_TARGET_X_TOLERANCE

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsOracleTargetMlLine = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "targetX", _
        dblTargetX

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strLine As String, dblTargetX As Double
' Returns:       Boolean
' Description:   Detects a visible rectangle whose left/right edge lies at a
'                target X. re n is ignored because V18.2 rejected that hypothesis.
'-------------------------------------------------------------------------------
Private Function VisibleRectangleTouchesOracleTargetX( _
    ByVal strLine As String, _
    ByVal dblTargetX As Double) As Boolean

    Const METHOD_NAME As String = "VisibleRectangleTouchesOracleTargetX"
    Dim arrTokens As Variant
    Dim dblLeftX As Double
    Dim dblRightX As Double
    Dim dblWidth As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strPaintOperator As String

    On Error GoTo ErrorHandler

    VisibleRectangleTouchesOracleTargetX = False

    If InStr(1, strLine, " re ", vbBinaryCompare) = 0 Then GoTo ExitFunction

    arrTokens = Split(Trim$(strLine), " ")

    For lngIndex = LBound(arrTokens) To UBound(arrTokens)
        If CStr(arrTokens(lngIndex)) = "re" Then
            If lngIndex >= 4 And lngIndex < UBound(arrTokens) Then
                strPaintOperator = CStr(arrTokens(lngIndex + 1))

                If IsVisibleRectanglePaintOperator(strPaintOperator) Then
                    dblLeftX = Val(CStr(arrTokens(lngIndex - 4)))
                    dblWidth = Val(CStr(arrTokens(lngIndex - 2)))
                    dblRightX = dblLeftX + dblWidth

                    If Abs(dblLeftX - dblTargetX) <= ORACLE_PARSER_TARGET_X_TOLERANCE Or _
                       Abs(dblRightX - dblTargetX) <= ORACLE_PARSER_TARGET_X_TOLERANCE Then

                        VisibleRectangleTouchesOracleTargetX = True
                        GoTo ExitFunction
                    End If
                End If
            End If
        End If
    Next lngIndex

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    VisibleRectangleTouchesOracleTargetX = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "targetX", _
        dblTargetX

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strOperator As String
' Returns:       Boolean
' Description:   Identifies visible PDF rectangle paint/stroke operators.
'-------------------------------------------------------------------------------
Private Function IsVisibleRectanglePaintOperator(ByVal strOperator As String) As Boolean
    Const METHOD_NAME As String = "IsVisibleRectanglePaintOperator"
