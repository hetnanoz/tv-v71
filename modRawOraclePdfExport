    ByVal dblTextX As Double, _
    ByVal dblTextWidth As Double, _
    ByVal dblCellX As Double, _
    ByVal dblCellWidth As Double) As Boolean

    Const METHOD_NAME As String = "ShouldUseOracleCellOverflowClip"
