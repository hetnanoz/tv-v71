'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    arrTopX As Variant, arrBottomX As Variant, dblHeaderBottomY As Double, dblHeaderTopY As Double, dblTableTopY As Double
' Returns:       String
' Description:   Draws the Oracle header rules once using m, l, and S.
'-------------------------------------------------------------------------------
Private Function BuildHeaderGridStrokeContent( _
    ByVal arrTopX As Variant, _
    ByVal arrBottomX As Variant, _
    ByVal dblHeaderBottomY As Double, _
    ByVal dblHeaderTopY As Double, _
    ByVal dblTableTopY As Double) As String

    Const METHOD_NAME As String = "BuildHeaderGridStrokeContent"
    Const CURRENT_HEADER_X As Double = 594#
    Const ORACLE_HEADER_X As Double = 598.52
    Const X_TOLERANCE As Double = 0.01
    Dim arrOracleHeaderTopX As Variant
    Dim blnHeaderXAdjusted As Boolean
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    If Not IsArray(arrTopX) Then
        Err.Raise 1024, METHOD_NAME, "The upper header X-coordinate configuration is not an array."
    End If

    arrOracleHeaderTopX = arrTopX

    For lngIndex = LBound(arrOracleHeaderTopX) To UBound(arrOracleHeaderTopX)
        If Abs(CDbl(arrOracleHeaderTopX(lngIndex)) - CURRENT_HEADER_X) < X_TOLERANCE Then
            arrOracleHeaderTopX(lngIndex) = ORACLE_HEADER_X
            blnHeaderXAdjusted = True
            Exit For
        End If
    Next lngIndex

    If Not blnHeaderXAdjusted Then
        Err.Raise 1024, METHOD_NAME, "The audited X=594 upper-header boundary was not found."
    End If

    strContent = BuildLineCommand( _
        TABLE_LEFT_X, _
        dblHeaderTopY, _
        ORACLE_RULE_RIGHT_X, _
        dblHeaderTopY)

    strContent = strContent & BuildInteriorVerticalLines( _
        arrOracleHeaderTopX, _
        dblHeaderTopY, _
        dblTableTopY)

    strContent = strContent & BuildOracleParserSensitiveBottomVerticalLines( _
        arrBottomX, _
        dblHeaderBottomY, _
        dblHeaderTopY)

    ' FIX19: Oracle Clone Audit reports one OLD-only micro vertical rule at
    ' X=180, Y=553.40..553.48 on page 1. Express it relative to tableTopY so
    ' continuation pages keep the same 0.08 pt Oracle header artifact.
    strContent = strContent & BuildLineCommand( _
        ORACLE_HEADER_MICRO_RULE_X, _
        dblTableTopY - ORACLE_HEADER_MICRO_RULE_HEIGHT, _
        ORACLE_HEADER_MICRO_RULE_X, _
        dblTableTopY)

    BuildHeaderGridStrokeContent = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildHeaderGridStrokeContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "headerBottomY;headerTopY;tableTopY", _
        dblHeaderBottomY, _
        dblHeaderTopY, _
        dblTableTopY

    errorManager.save
    Resume ExitFunction
End Function


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    arrTopX As Variant, arrBottomX As Variant, dblTopRowTopY As Double, dblTopRowBottomY As Double, dblBottomRowBottomY As Double, dblBottomBaseline As Double, dblSeparatorBottomY As Double, blnDrawTopBoundary As Boolean, blnDrawSeparatorBottom As Boolean
' Returns:       String
' Description:   Draws the Oracle transaction rules; X=468/X=639 use the OLD transaction-relative span.
'-------------------------------------------------------------------------------
Private Function BuildTransactionGridStrokeContent( _
    ByVal arrTopX As Variant, _
    ByVal arrBottomX As Variant, _
    ByVal dblTopRowTopY As Double, _
    ByVal dblTopRowBottomY As Double, _
    ByVal dblBottomRowBottomY As Double, _
    ByVal dblBottomBaseline As Double, _
    ByVal dblSeparatorBottomY As Double, _
    ByVal blnDrawTopBoundary As Boolean, _
    ByVal blnDrawSeparatorBottom As Boolean) As String

    Const METHOD_NAME As String = "BuildTransactionGridStrokeContent"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    ' FIX19: B*/re S rectangle edges already provide the trade top, lower-row
    ' bottom and separator-bottom horizontals. Drawing those again as m/l/S
    ' created exactly the four GEOMETRY_ONLY_NEW lines reported by the latest
    ' two-trade audit (Y=481.48, 476.96, 477 and 441). Only the internal
    ' top-row/bottom-row boundary is an independent horizontal m/l/S rule.
    strContent = BuildLineCommand( _
        TABLE_LEFT_X, _
        dblTopRowBottomY, _
        ORACLE_RULE_RIGHT_X, _
        dblTopRowBottomY)

    strContent = strContent & BuildInteriorVerticalLines( _
        arrTopX, _
        dblTopRowBottomY, _
        dblTopRowTopY)

    strContent = strContent & BuildOracleParserSensitiveBottomVerticalLines( _
        arrBottomX, _
        dblBottomRowBottomY, _
        dblTopRowBottomY, _
        True, _
        dblBottomBaseline)

    BuildTransactionGridStrokeContent = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildTransactionGridStrokeContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topRowTopY;topRowBottomY;bottomRowBottomY;bottomBaseline;separatorBottomY", _
        dblTopRowTopY, _
        dblTopRowBottomY, _
        dblBottomRowBottomY, _
        dblBottomBaseline, _
        dblSeparatorBottomY

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-06
' Parameters:    arrX As Variant, dblBottomY As Double, dblTopY As Double
' Returns:       String
' Description:   Draws each internal vertical grid boundary once as an m/l stroke.
'-------------------------------------------------------------------------------
Private Function BuildInteriorVerticalLines( _
    ByVal arrX As Variant, _
    ByVal dblBottomY As Double, _
    ByVal dblTopY As Double) As String

    Const METHOD_NAME As String = "BuildInteriorVerticalLines"
    Dim errorManager As New ErrorManager
