    End If

    If dblTopY <= dblBottomY Then
        Err.Raise 1024, METHOD_NAME, "The vertical line span is not positive."
    End If

    For lngIndex = LBound(arrX) + 1 To UBound(arrX)
        strContent = strContent & BuildLineCommand( _
            CDbl(arrX(lngIndex)), _
            dblBottomY, _
            CDbl(arrX(lngIndex)), _
            dblTopY)
    Next lngIndex

    BuildInteriorVerticalLines = strContent

ExitFunction:
