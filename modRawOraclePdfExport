Private Function ResolveOracleBlankClipText( _
    ByVal blnHeader As Boolean, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As String

    Const METHOD_NAME As String = "ResolveOracleBlankClipText"
