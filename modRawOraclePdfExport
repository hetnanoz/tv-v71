'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, logoPath As String, strLogoHex As String, lngLogoWidth As Long, lngLogoHeight As Long, lngLogoComponents As Long
' Returns:       Boolean
' Description:   Reads or exports the existing report logo and converts it to ASCII hexadecimal JPEG data.
'-------------------------------------------------------------------------------
Private Function PrepareLogoImage( _
    ByVal wksSource As Excel.Worksheet, _
    ByVal logoPath As String, _
    ByRef strLogoHex As String, _
    ByRef lngLogoWidth As Long, _
    ByRef lngLogoHeight As Long, _
    ByRef lngLogoComponents As Long) As Boolean

    Const METHOD_NAME As String = "PrepareLogoImage"
    Dim arrBytes() As Byte
    Dim blnTemporaryFile As Boolean
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim fso As Object
    Dim strImagePath As String
    Dim strTempPath As String

    On Error GoTo ErrorHandler

    PrepareLogoImage = False
    Set fso = CreateObject("Scripting.FileSystemObject")

    If fso.FileExists(logoPath) Then
        If LCase$(fso.GetExtensionName(logoPath)) = "jpg" Or _
           LCase$(fso.GetExtensionName(logoPath)) = "jpeg" Then
            strImagePath = logoPath
        End If
    End If

    If Len(strImagePath) = 0 Then
        strTempPath = Environ$("TEMP") & "\Tradeversand_OracleLogo_" & _
                      Format$(Now, "yyyymmdd_hhnnss") & "_" & _
                      Format$(CLng(Timer * 100), "00000000") & ".jpg"

        If Not ExportWorksheetLogoToJpeg(wksSource, strTempPath) Then
            GoTo ExitFunction
        End If

        strImagePath = strTempPath
        blnTemporaryFile = True
    End If

    arrBytes = ReadFileBytes(strImagePath)

    If Not GetJpegInformation(arrBytes, lngLogoWidth, lngLogoHeight, lngLogoComponents) Then
        Err.Raise 1013, METHOD_NAME, "The prepared logo is not a supported JPEG image."
    End If

    strLogoHex = BytesToAsciiHex(arrBytes)
    PrepareLogoImage = (Len(strLogoHex) > 1)

ExitFunction:
    If blnTemporaryFile Then
        On Error Resume Next
        If Len(Dir$(strTempPath)) > 0 Then
            Kill strTempPath
        End If
        On Error GoTo 0
    End If

    Set fso = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    PrepareLogoImage = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "logoPath", _
        logoPath

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, targetJpegPath As String
' Returns:       Boolean
' Description:   Exports the first worksheet picture to a temporary JPEG file.
'-------------------------------------------------------------------------------
Private Function ExportWorksheetLogoToJpeg( _
    ByVal wksSource As Excel.Worksheet, _
    ByVal targetJpegPath As String) As Boolean

    Const METHOD_NAME As String = "ExportWorksheetLogoToJpeg"
    Dim chartLogo As Excel.ChartObject
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngShape As Long
    Dim shpLogo As Excel.Shape

    On Error GoTo ErrorHandler

    ExportWorksheetLogoToJpeg = False

    For lngShape = 1 To wksSource.Shapes.Count
        If wksSource.Shapes(lngShape).Type = 13 Or wksSource.Shapes(lngShape).Type = 11 Then
            Set shpLogo = wksSource.Shapes(lngShape)
            Exit For
        End If
    Next lngShape

    If shpLogo Is Nothing Then
        Err.Raise 1013, METHOD_NAME, "No picture shape was found on the report worksheet."
    End If

    Set chartLogo = wksSource.ChartObjects.Add( _
        Left:=shpLogo.Left, _
        Top:=shpLogo.Top, _
        Width:=shpLogo.Width, _
        Height:=shpLogo.Height)

    shpLogo.CopyPicture Appearance:=xlScreen, Format:=xlPicture
    DoEvents
    chartLogo.Chart.Paste
    DoEvents

    ExportWorksheetLogoToJpeg = chartLogo.Chart.Export( _
        Filename:=targetJpegPath, _
        FilterName:="JPG")

ExitFunction:
    If Not chartLogo Is Nothing Then
        On Error Resume Next
        chartLogo.Delete
        On Error GoTo 0
    End If

    Set shpLogo = Nothing
    Set chartLogo = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ExportWorksheetLogoToJpeg = False

    errorManager.addError _
