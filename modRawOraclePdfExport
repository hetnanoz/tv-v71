    On Error GoTo ErrorHandler

    ' FIX39: OLD Blueprint V3 contains one whitespace-only /F0 8 pt Tj per
    ' page at the page-number anchor. Keep the same visible text, but serialize
    ' the separating blank as its own text-show operation.
    BuildPageNumberCommand = _
        "BT /F0 " & PdfNumber(PAGE_NUMBER_FONT_SIZE) & " Tf " & _
        PdfNumber(PAGE_NUMBER_X) & " " & PdfNumber(PAGE_NUMBER_Y) & " Td (" & _
        EncodePdfText(CStr(lngPage)) & ") Tj ( ) Tj (/) Tj (" & _
        EncodePdfText(CStr(lngPageCount)) & ") Tj ET" & vbCrLf

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildPageNumberCommand = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "page;pageCount", _
        lngPage, _
        lngPageCount

    errorManager.save
    Resume ExitFunction
End Function
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    strText As String
' Returns:       String
' Description:   Encodes text as an ASCII-safe WinAnsi PDF literal string.
'-------------------------------------------------------------------------------
Private Function EncodePdfText(ByVal strText As String) As String
    Const METHOD_NAME As String = "EncodePdfText"
    Dim arrBytes() As Byte
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngByte As Long
    Dim lngIndex As Long
    Dim strEncoded As String

    On Error GoTo ErrorHandler

    EncodePdfText = vbNullString

    If Len(strText) = 0 Then
        GoTo ExitFunction
    End If

    arrBytes = StrConv(strText, vbFromUnicode)

    For lngIndex = LBound(arrBytes) To UBound(arrBytes)
        lngByte = CLng(arrBytes(lngIndex))

        Select Case lngByte
            Case 40
                strEncoded = strEncoded & "\("
            Case 41
                strEncoded = strEncoded & "\)"
            Case 92
                strEncoded = strEncoded & "\\"
            Case 32 To 126
                strEncoded = strEncoded & Chr$(lngByte)
            Case Else
                strEncoded = strEncoded & "\" & Right$("000" & Oct$(lngByte), 3)
        End Select
    Next lngIndex

    EncodePdfText = strEncoded

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    EncodePdfText = vbNullString

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
