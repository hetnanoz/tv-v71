'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-10
' Parameters:    strText As String
' Returns:       String
' Description:   Groups the integer part in blocks of three while preserving decimals.
'-------------------------------------------------------------------------------
Private Function FormatOracleGroupedNumericText( _
    ByVal strText As String) As String

    Const METHOD_NAME As String = "FormatOracleGroupedNumericText"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngComma As Long
    Dim lngDecimalPosition As Long
    Dim lngDot As Long
    Dim strDecimalSeparator As String
    Dim strFractionPart As String
    Dim strIntegerPart As String
    Dim strResult As String
    Dim strSign As String
    Dim strWorking As String

    On Error GoTo ErrorHandler

    FormatOracleGroupedNumericText = strText
    strWorking = Trim$(Replace(strText, ChrW(160), " "))

    If Len(strWorking) = 0 Then
        GoTo ExitFunction
    End If

    If Left$(strWorking, 1) = "-" Or Left$(strWorking, 1) = "+" Then
        strSign = Left$(strWorking, 1)
        strWorking = Mid$(strWorking, 2)
    End If

    lngDot = InStrRev(strWorking, ".")
    lngComma = InStrRev(strWorking, ",")

    If lngDot > lngComma Then
        lngDecimalPosition = lngDot
        strDecimalSeparator = "."
    ElseIf lngComma > 0 Then
        lngDecimalPosition = lngComma
        strDecimalSeparator = ","
    End If

    If lngDecimalPosition > 0 Then
        strIntegerPart = Left$(strWorking, lngDecimalPosition - 1)
        strFractionPart = Mid$(strWorking, lngDecimalPosition + 1)
    Else
        strIntegerPart = strWorking
    End If

    strIntegerPart = Replace(strIntegerPart, " ", vbNullString)
    strIntegerPart = Replace(strIntegerPart, "'", vbNullString)

    If strDecimalSeparator = "." Then
        strIntegerPart = Replace(strIntegerPart, ",", vbNullString)
    ElseIf strDecimalSeparator = "," Then
        strIntegerPart = Replace(strIntegerPart, ".", vbNullString)
    End If

    strFractionPart = Replace(strFractionPart, " ", vbNullString)

    If Not IsOracleDigitString(strIntegerPart) Then
        GoTo ExitFunction
    End If

    If Len(strFractionPart) > 0 Then
        If Not IsOracleDigitString(strFractionPart) Then
            GoTo ExitFunction
        End If
    End If

    strResult = strSign & GroupOracleIntegerDigits(strIntegerPart)

    If Len(strFractionPart) > 0 Then
        strResult = strResult & strDecimalSeparator & strFractionPart
    End If

    FormatOracleGroupedNumericText = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    FormatOracleGroupedNumericText = strText

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "text", _
        strText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-10
' Parameters:    strDigits As String
' Returns:       String
' Description:   Inserts regular spaces between three-digit integer groups.
'-------------------------------------------------------------------------------
Private Function GroupOracleIntegerDigits( _
    ByVal strDigits As String) As String

    Const METHOD_NAME As String = "GroupOracleIntegerDigits"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFirstGroupLength As Long
    Dim lngIndex As Long
    Dim strResult As String

    On Error GoTo ErrorHandler

    GroupOracleIntegerDigits = strDigits

    If Len(strDigits) <= 3 Then
        GoTo ExitFunction
    End If

    lngFirstGroupLength = Len(strDigits) Mod 3

    If lngFirstGroupLength = 0 Then
        lngFirstGroupLength = 3
    End If

    strResult = Left$(strDigits, lngFirstGroupLength)
    lngIndex = lngFirstGroupLength + 1

    Do While lngIndex <= Len(strDigits)
        strResult = strResult & " " & Mid$(strDigits, lngIndex, 3)
        lngIndex = lngIndex + 3
    Loop

    GroupOracleIntegerDigits = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GroupOracleIntegerDigits = strDigits

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "digits", _
        strDigits

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-10
' Parameters:    strText As String
' Returns:       Boolean
' Description:   Returns whether the supplied string contains decimal digits only.
'-------------------------------------------------------------------------------
Private Function IsOracleDigitString( _
    ByVal strText As String) As Boolean

    Const METHOD_NAME As String = "IsOracleDigitString"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strCharacter As String

    On Error GoTo ErrorHandler

    IsOracleDigitString = False

    If Len(strText) = 0 Then
        GoTo ExitFunction
    End If

    For lngIndex = 1 To Len(strText)
        strCharacter = Mid$(strText, lngIndex, 1)

        If strCharacter < "0" Or strCharacter > "9" Then
            GoTo ExitFunction
        End If
    Next lngIndex

    IsOracleDigitString = True

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsOracleDigitString = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "text", _
        strText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-10
' Parameters:    strText As String
' Returns:       Boolean
' Description:   Returns whether a formatted numeric value equals one.
'-------------------------------------------------------------------------------
Private Function IsOracleUnitNumericText( _
    ByVal strText As String) As Boolean

    Const METHOD_NAME As String = "IsOracleUnitNumericText"
    Dim dblValue As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strCore As String

    On Error GoTo ErrorHandler

    IsOracleUnitNumericText = False
    strCore = Replace(Trim$(strText), " ", vbNullString)
    strCore = Replace(strCore, ChrW(160), vbNullString)
    strCore = Replace(strCore, ",", ".")

    If Len(strCore) = 0 Then
        GoTo ExitFunction
    End If

    dblValue = Val(strCore)
    IsOracleUnitNumericText = (Abs(dblValue - 1#) < 0.000000000001)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsOracleUnitNumericText = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "text", _
        strText

    errorManager.save
    Resume ExitFunction
End Function

