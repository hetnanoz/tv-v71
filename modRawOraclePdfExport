End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    arrTopX As Variant, arrBottomX As Variant, dblTopBaseline As Double, dblBottomBaseline As Double, dblTopRowTopY As Double, dblTopRowBottomY As Double, dblBottomRowBottomY As Double, dblSeparatorBottomY As Double, blnDrawTopBoundary As Boolean, blnDrawSeparatorBottom As Boolean
' Returns:       String
' Description:   Builds one Oracle Reports transaction block with the original rectangle roles and single-stroke grid.
'-------------------------------------------------------------------------------
Private Function BuildOracleTransactionStructure( _
    ByVal arrTopX As Variant, _
    ByVal arrBottomX As Variant, _
    ByVal dblTopBaseline As Double, _
    ByVal dblBottomBaseline As Double, _
    ByVal dblTopRowTopY As Double, _
    ByVal dblTopRowBottomY As Double, _
    ByVal dblBottomRowBottomY As Double, _
    ByVal dblSeparatorBottomY As Double, _
    ByVal blnDrawTopBoundary As Boolean, _
    ByVal blnDrawSeparatorBottom As Boolean) As String

    Const METHOD_NAME As String = "BuildOracleTransactionStructure"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    strContent = BuildStrokedRectangleCommand( _
        TABLE_LEFT_X, _
        dblSeparatorBottomY, _
        TABLE_WIDTH, _
        dblTopRowTopY - dblSeparatorBottomY)

    ' FIX37A PART 1:
    ' The nine former structure-level plain re n rectangles are intentionally
    ' not emitted here. They are now emitted later, immediately around the
    ' corresponding lower-row text run as q -> re W n -> BT/Tj/ET -> Q.
    ' This preserves the OLD Oracle clipping state through text extraction.

    ' FIX20: Oracle draws the inter-trade separator as a filled/stroked
    ' rectangle. This reproduces the OLD B*/re vector role and the slightly
    ' gray separator band without changing any audited X/Y geometry.
    strContent = strContent & BuildFilledStrokedRectangleCommand( _
        TABLE_LEFT_X, _
        dblSeparatorBottomY, _
        TABLE_WIDTH, _
        dblBottomRowBottomY - dblSeparatorBottomY, _
        SEPARATOR_GRAY_LEVEL)

    strContent = strContent & BuildTransactionGridStrokeContent( _
        arrTopX, _
        arrBottomX, _
        dblTopRowTopY, _
        dblTopRowBottomY, _
        dblBottomRowBottomY, _
        dblBottomBaseline, _
        dblSeparatorBottomY, _
        blnDrawTopBoundary, _
        blnDrawSeparatorBottom)

    BuildOracleTransactionStructure = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildOracleTransactionStructure = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topBaseline;bottomBaseline;topRowTopY;separatorBottomY", _
        dblTopBaseline, _
        dblBottomBaseline, _
        dblTopRowTopY, _
        dblSeparatorBottomY

    errorManager.save
    Resume ExitFunction
End Function
