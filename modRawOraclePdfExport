'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngOracleClipRow As Long, lngFieldIndex As Long, dblBaselineY As Double, blnHasText As Boolean, lngClipDepth As Long
' Returns:       String
' Description:   Opens the complete OLD-Oracle clipping stack for one logical cell.
'                FIX37A restored the 600 core clips. FIX37B adds the supplemental
'                WKN, Nominale, Kurs and Whg-Spesen clip families from Blueprint V2.
'-------------------------------------------------------------------------------
Private Function BuildOracleCellClipOpenContent( _
    ByVal lngOracleClipRow As Long, _
    ByVal lngFieldIndex As Long, _
    ByVal dblBaselineY As Double, _
    ByVal blnHasText As Boolean, _
    ByRef lngClipDepth As Long) As String

    Const METHOD_NAME As String = "BuildOracleCellClipOpenContent"
    Dim arrDetailWidths As Variant
    Dim arrDetailX As Variant
    Dim dblClipHeight As Double
    Dim dblClipWidth As Double
    Dim dblClipX As Double
    Dim dblClipY As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngDetailIndex As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    BuildOracleCellClipOpenContent = vbNullString
    lngClipDepth = 0
    lngDetailIndex = -1

    Select Case lngOracleClipRow
        Case ORACLE_CLIP_ROW_HEADER_TOP
            If lngFieldIndex = TOP_FIELD_STUECKZINSEN_INDEX Then
                dblClipX = ORACLE_HEADER_SPECIAL_X
                dblClipY = dblBaselineY - ORACLE_HEADER_CLIP_BASELINE_OFFSET
                dblClipWidth = ORACLE_HEADER_SPECIAL_WIDTH
                dblClipHeight = ORACLE_DETAIL_HEIGHT

                strContent = BuildOracleClipOpenCommand( _
                    dblClipX, _
                    dblClipY, _
                    dblClipWidth, _
                    dblClipHeight)

                lngClipDepth = 1
            End If

        Case ORACLE_CLIP_ROW_TRANSACTION_TOP
            ' FIX37B/FIX39:
            ' Nominale and Kurs keep their OLD Oracle text-scoped clips here.
            ' WKN is resolved later from actual text width because Blueprint V3
            ' proves its clip is content-dependent rather than merely nonblank.
            If blnHasText Then
                Select Case lngFieldIndex
                    ' WKN is intentionally handled later in BuildCellContent.
                    ' OLD clips only the WKN values that actually overflow the
                    ' x=558..589.52 text box; clipping every populated WKN would
                    ' contradict the 34/66 OLD Blueprint V3 count.
                    Case TOP_FIELD_NOMINALE_INDEX
                        dblClipX = ORACLE_TOP_NOMINALE_CLIP_X
                        dblClipY = dblBaselineY
                        dblClipWidth = ORACLE_TOP_NOMINALE_CLIP_WIDTH
                        dblClipHeight = ORACLE_DETAIL_HEIGHT

                    Case TOP_FIELD_KURS_INDEX
                        dblClipX = ORACLE_TOP_KURS_CLIP_X
                        dblClipY = dblBaselineY
                        dblClipWidth = ORACLE_TOP_KURS_CLIP_WIDTH
                        dblClipHeight = ORACLE_DETAIL_HEIGHT
                End Select

                If dblClipWidth > 0# And dblClipHeight > 0# Then
                    strContent = BuildOracleClipOpenCommand( _
                        dblClipX, _
                        dblClipY, _
                        dblClipWidth, _
                        dblClipHeight)

                    lngClipDepth = 1
                End If
            End If

        Case ORACLE_CLIP_ROW_TRANSACTION_BOTTOM
            ' These mappings are exactly the nine FIX36 GetOracleBottomDetailX
            ' rectangles. FIX37A moved them from structure-level plain re n into
            ' text-scoped re W n without altering X, width, Y, or height.
            Select Case lngFieldIndex
                Case BOTTOM_FIELD_MAKLERGEBUEHREN_INDEX
                    lngDetailIndex = 0
                Case BOTTOM_FIELD_WHG_MAKLER_INDEX
                    lngDetailIndex = 1
                Case BOTTOM_FIELD_STEUERN_INDEX
                    lngDetailIndex = 2
                Case BOTTOM_FIELD_ABWICKLUNG_INDEX
                    lngDetailIndex = 3
                Case BOTTOM_FIELD_SPESEN_INDEX
                    lngDetailIndex = 4
                Case BOTTOM_FIELD_AMOUNT_WHG_INDEX
                    lngDetailIndex = 5
                Case BOTTOM_FIELD_ABRECH_AMOUNT_INDEX
                    lngDetailIndex = 6
                Case BOTTOM_FIELD_WHG_ABRECH_INDEX
                    lngDetailIndex = 7
                Case BOTTOM_FIELD_DEVISENKURS_INDEX
                    lngDetailIndex = 8
            End Select

            If lngDetailIndex >= 0 Then
                arrDetailX = GetOracleBottomDetailX()
                arrDetailWidths = GetOracleBottomDetailWidths()

                If UBound(arrDetailX) <> UBound(arrDetailWidths) Then
                    Err.Raise 1024, METHOD_NAME, _
                        "The Oracle bottom clip geometry arrays do not match."
                End If

                If lngDetailIndex > UBound(arrDetailX) Then
                    Err.Raise 1024, METHOD_NAME, _
                        "The Oracle bottom clip geometry index is outside the configured array."
                End If

                dblClipX = CDbl(arrDetailX(lngDetailIndex))
                dblClipY = dblBaselineY
                dblClipWidth = CDbl(arrDetailWidths(lngDetailIndex))
                dblClipHeight = ORACLE_DETAIL_HEIGHT

                strContent = BuildOracleClipOpenCommand( _
                    dblClipX, _
                    dblClipY, _
                    dblClipWidth, _
                    dblClipHeight)

                lngClipDepth = 1
            End If

            ' The OLD blueprint contains one additional lower-row clip family:
            ' x=859.52, width=27, height=9. It sits inside Whg Spesen and appears
            ' only when that currency field is populated.
            If blnHasText And lngFieldIndex = BOTTOM_FIELD_WHG_SPESEN_INDEX Then
                strContent = strContent & BuildOracleClipOpenCommand( _
                    ORACLE_BOTTOM_WHG_SPESEN_CLIP_X, _
                    dblBaselineY, _
                    ORACLE_BOTTOM_WHG_SPESEN_CLIP_WIDTH, _
                    ORACLE_DETAIL_HEIGHT)

                lngClipDepth = lngClipDepth + 1
            End If
    End Select

    BuildOracleCellClipOpenContent = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildOracleCellClipOpenContent = vbNullString
    lngClipDepth = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "clipRow;fieldIndex;baselineY;hasText", _
        lngOracleClipRow, _
        lngFieldIndex, _
        dblBaselineY, _
        blnHasText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    dblX As Double, dblY As Double, dblWidth As Double, dblHeight As Double
