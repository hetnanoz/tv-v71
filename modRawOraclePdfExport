'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    dblTextX As Double, dblTextWidth As Double
' Returns:       Boolean
' Description:   Decides whether a populated WKN needs the OLD Oracle
'                x=558..589.52 overflow clip. Short WKN values stay unclipped.
'-------------------------------------------------------------------------------
Private Function ShouldUseOracleWknOverflowClip( _
    ByVal dblTextX As Double, _
    ByVal dblTextWidth As Double) As Boolean

    Const METHOD_NAME As String = "ShouldUseOracleWknOverflowClip"
    Const CLIP_TOLERANCE As Double = 0.01
    Dim dblClipRight As Double
    Dim dblTextRight As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    dblClipRight = ORACLE_WKN_CLIP_X + ORACLE_WKN_CLIP_WIDTH
    dblTextRight = dblTextX + dblTextWidth

    ShouldUseOracleWknOverflowClip = _
        (dblTextX < ORACLE_WKN_CLIP_X - CLIP_TOLERANCE) Or _
        (dblTextRight > dblClipRight + CLIP_TOLERANCE)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ShouldUseOracleWknOverflowClip = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "textX;textWidth", _
        dblTextX, _
        dblTextWidth

    errorManager.save
    Resume ExitFunction
End Function


