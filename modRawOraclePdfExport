'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    strText As String, blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       Double
' Description:   Resolves Oracle data font size, including fixed 9 pt ISIN values.
'-------------------------------------------------------------------------------
Private Function ResolveOracleDataFontSize( _
    ByVal strText As String, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As Double

    Const METHOD_NAME As String = "ResolveOracleDataFontSize"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    ResolveOracleDataFontSize = GetDataFontSize(strText)

    If blnTopTransactionRow Then
        If lngFieldIndex = TOP_FIELD_ISIN_INDEX Then
            ResolveOracleDataFontSize = DATA_FONT_SIZE
        ElseIf lngFieldIndex = TOP_FIELD_SECURITY_DESCRIPTION_INDEX Or _
               lngFieldIndex = TOP_FIELD_WHG_INDEX Then

            ResolveOracleDataFontSize = LONG_TEXT_FONT_SIZE
        End If
    Else
        ' V11 structural-field audit proved that the currency cell immediately
        ' before Devisenkurs (Whg for ausm. Betrag in Abrech. Whg) is 8 pt in
        ' the OLD Oracle PDF. FIX27 still emitted it at 9 pt, producing the
        ' repeated dY=-0.76 and dX about -0.74..-1.00 family.
        If lngFieldIndex = BOTTOM_FIELD_WHG_ABRECH_INDEX Then
            ResolveOracleDataFontSize = LONG_TEXT_FONT_SIZE
        ElseIf IsOracleCurrencyField(False, lngFieldIndex) Or _
               lngFieldIndex = BOTTOM_FIELD_SPESEN_INDEX Then

            ResolveOracleDataFontSize = DATA_FONT_SIZE
        ElseIf lngFieldIndex = BOTTOM_FIELD_DEVISENKURS_INDEX Then
            ResolveOracleDataFontSize = LONG_TEXT_FONT_SIZE
        End If
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveOracleDataFontSize = DATA_FONT_SIZE

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "text;topTransactionRow;fieldIndex", _
        strText, _
        blnTopTransactionRow, _
        lngFieldIndex

    errorManager.save
    Resume ExitFunction
End Function

