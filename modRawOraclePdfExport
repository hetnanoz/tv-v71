    ByVal blnStornoReport As Boolean) As String

    Const METHOD_NAME As String = "ResolveOracleFooterFont"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    ' FIX33: the latest semantic-font audit proved that the footer is
    ' Arial,Bold at 8 pt in both standard and Storno reports. The OLD alias
    ' may be /F1 or /F2, so alias selection must not drive the font family.
    ResolveOracleFooterFont = "/F2"

ExitFunction:
