Private Function BuildPageNumberCommand( _
    ByVal lngPage As Long, _
    ByVal lngPageCount As Long) As String

    Const METHOD_NAME As String = "BuildPageNumberCommand"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
