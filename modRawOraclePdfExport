'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksMacro As Excel.Worksheet
' Returns:       Boolean
' Description:   Returns whether the raw Oracle-compatible PDF mode is enabled.
'-------------------------------------------------------------------------------
Public Function IsRawOraclePdfEnabled(ByVal wksMacro As Excel.Worksheet) As Boolean
    Const METHOD_NAME As String = "IsRawOraclePdfEnabled"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngFlag As Excel.Range
    Dim strFlag As String
    Dim varFlag As Variant

    On Error GoTo ErrorHandler

    IsRawOraclePdfEnabled = False

    If wksMacro Is Nothing Then
        Err.Raise 1001, METHOD_NAME, "The Tradeversand worksheet is required."
    End If

    On Error Resume Next
    Set rngFlag = wksMacro.Range(CONFIG_RANGE_NAME)
    On Error GoTo ErrorHandler

    If rngFlag Is Nothing Then
        GoTo ExitFunction
    End If

    varFlag = rngFlag.Value

    If VarType(varFlag) = vbBoolean Then
        IsRawOraclePdfEnabled = CBool(varFlag)
        GoTo ExitFunction
    End If

    If IsNumeric(varFlag) Then
        IsRawOraclePdfEnabled = (CDbl(varFlag) <> 0#)
        GoTo ExitFunction
    End If

    strFlag = UCase$(Trim$(CStr(varFlag)))
    IsRawOraclePdfEnabled = _
        (strFlag = "TRUE" Or strFlag = "PRAWDA" Or strFlag = "YES" Or _
         strFlag = "JA" Or strFlag = "ORACLE" Or strFlag = "1")

ExitFunction:
    Set rngFlag = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsRawOraclePdfEnabled = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    targetPath As String, wksSource As Excel.Worksheet, logoPath As String
' Returns:       Boolean
' Description:   Generates a synchronous raw PDF 1.4 from the completed report worksheet.
'-------------------------------------------------------------------------------
Public Function GenerateRawOraclePdfFromWorksheet( _
    ByVal targetPath As String, _
    ByVal wksSource As Excel.Worksheet, _
    ByVal logoPath As String) As Boolean

    Const METHOD_NAME As String = "GenerateRawOraclePdfFromWorksheet"
    Dim arrBottomRows() As Long
    Dim arrTopRows() As Long
    Dim blnFileOpened As Boolean
    Dim blnHasLogo As Boolean
    Dim colPageContents As Collection
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFileNumber As Long
    Dim lngLogoComponents As Long
    Dim lngLogoHeight As Long
    Dim lngLogoWidth As Long
    Dim lngTradeCount As Long
    Dim strDocument As String
    Dim strLogoHex As String

    On Error GoTo ErrorHandler

    GenerateRawOraclePdfFromWorksheet = False

    Debug.Print "modRawOraclePdfExport " & RAW_ORACLE_BUILD_SIGNATURE & _
        " | target=" & targetPath

    If wksSource Is Nothing Then
        Err.Raise 1001, METHOD_NAME, "The completed report worksheet is required."
    End If

    If Not ValidateTargetPath(targetPath) Then
        Err.Raise 1020, METHOD_NAME, "The target PDF path is invalid or inaccessible."
    End If

    wksSource.Calculate

    If Not CollectTransactionRows(wksSource, arrTopRows, arrBottomRows, lngTradeCount) Then
        Err.Raise 1001, METHOD_NAME, "No transaction row pairs were found in the report worksheet."
    End If

    blnHasLogo = PrepareLogoImage( _
        wksSource, _
        logoPath, _
        strLogoHex, _
        lngLogoWidth, _
        lngLogoHeight, _
        lngLogoComponents)

    If Not blnHasLogo Then
        Err.Raise 1013, METHOD_NAME, "The report logo could not be prepared as a JPEG image."
    End If

    If Not BuildAllPageContents( _
        wksSource, _
        arrTopRows, _
        arrBottomRows, _
        lngTradeCount, _
        blnHasLogo, _
        colPageContents) Then

        Err.Raise 1024, METHOD_NAME, "The Oracle PDF page contents could not be built."
    End If

    If Not BuildPdfDocument( _
        colPageContents, _
        strLogoHex, _
        lngLogoWidth, _
        lngLogoHeight, _
        lngLogoComponents, _
        strDocument) Then

        Err.Raise 1024, METHOD_NAME, "The PDF object structure or XREF table could not be built."
    End If

    If Len(Dir$(targetPath)) > 0 Then
        Kill targetPath
    End If

    lngFileNumber = FreeFile
    Open targetPath For Output Access Write Lock Write As #lngFileNumber
    blnFileOpened = True
    Print #lngFileNumber, strDocument;
    Close #lngFileNumber
    blnFileOpened = False

    If Len(Dir$(targetPath)) = 0 Then
        Err.Raise 1011, METHOD_NAME, "The raw Oracle PDF file was not created."
    End If

    If FileLen(targetPath) <= 0 Then
        Err.Raise 1011, METHOD_NAME, "The raw Oracle PDF file is empty."
    End If

    If Not HasPdf14Header(targetPath) Then
        Err.Raise 1024, METHOD_NAME, "The generated file does not start with the PDF 1.4 header."
    End If

    GenerateRawOraclePdfFromWorksheet = True

ExitFunction:
    If blnFileOpened Then
        On Error Resume Next
        Close #lngFileNumber
        On Error GoTo 0
    End If

    If Not GenerateRawOraclePdfFromWorksheet Then
        On Error Resume Next
        If Len(Dir$(targetPath)) > 0 Then
            Kill targetPath
        End If
        On Error GoTo 0
    End If

    Set colPageContents = Nothing
    Set wksSource = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GenerateRawOraclePdfFromWorksheet = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "targetPath;tradeCount", _
        targetPath, _
        lngTradeCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    targetPath As String
' Returns:       Boolean
' Description:   Validates the target PDF path and its parent folder.
'-------------------------------------------------------------------------------
Private Function ValidateTargetPath(ByVal targetPath As String) As Boolean
    Const METHOD_NAME As String = "ValidateTargetPath"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim fso As Object
    Dim strParentFolder As String

    On Error GoTo ErrorHandler

    ValidateTargetPath = False

    If Len(Trim$(targetPath)) = 0 Then
        Err.Raise 1020, METHOD_NAME, "The target PDF path is required."
    End If

    If LCase$(Right$(Trim$(targetPath), 4)) <> ".pdf" Then
        Err.Raise 1020, METHOD_NAME, "The target path must end with .pdf."
    End If

    Set fso = CreateObject("Scripting.FileSystemObject")
    strParentFolder = CStr(fso.GetParentFolderName(targetPath))

    If Len(strParentFolder) = 0 Then
        Err.Raise 1020, METHOD_NAME, "The target parent folder could not be resolved."
    End If

    If Not fso.FolderExists(strParentFolder) Then
        Err.Raise 1022, METHOD_NAME, "The target parent folder does not exist."
    End If

    ValidateTargetPath = True

ExitFunction:
    Set fso = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ValidateTargetPath = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "targetPath", _
        targetPath

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long
' Returns:       Boolean
' Description:   Collects the two worksheet rows belonging to each transaction.
'-------------------------------------------------------------------------------
Private Function CollectTransactionRows( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByRef lngTradeCount As Long) As Boolean

    Const METHOD_NAME As String = "CollectTransactionRows"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCapacity As Long
    Dim lngLastRow As Long
    Dim lngRow As Long

    On Error GoTo ErrorHandler

    CollectTransactionRows = False
    lngTradeCount = 0
    lngLastRow = GetLastUsedRow(wksSource)

    If lngLastRow < FIRST_DATA_ROW + 1 Then
        GoTo ExitFunction
    End If

    lngCapacity = 16
    ReDim arrTopRows(1 To lngCapacity)
    ReDim arrBottomRows(1 To lngCapacity)

    lngRow = FIRST_DATA_ROW

    Do While lngRow <= lngLastRow - 1
        If IsTransactionRowPair(wksSource, lngRow, lngLastRow) Then
            lngTradeCount = lngTradeCount + 1

            If lngTradeCount > lngCapacity Then
                lngCapacity = lngCapacity * 2
                ReDim Preserve arrTopRows(1 To lngCapacity)
                ReDim Preserve arrBottomRows(1 To lngCapacity)
            End If

            arrTopRows(lngTradeCount) = lngRow
            arrBottomRows(lngTradeCount) = lngRow + 1
            lngRow = lngRow + 2
        Else
            lngRow = lngRow + 1
        End If
    Loop

    If lngTradeCount = 0 Then
        GoTo ExitFunction
    End If

    ReDim Preserve arrTopRows(1 To lngTradeCount)
    ReDim Preserve arrBottomRows(1 To lngTradeCount)
    CollectTransactionRows = True

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    CollectTransactionRows = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "lastRow;tradeCount", _
        lngLastRow, _
        lngTradeCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, lngTopRow As Long, lngLastRow As Long
' Returns:       Boolean
' Description:   Returns whether two consecutive worksheet rows form one transaction.
'-------------------------------------------------------------------------------
Private Function IsTransactionRowPair( _
    ByVal wksSource As Excel.Worksheet, _
    ByVal lngTopRow As Long, _
    ByVal lngLastRow As Long) As Boolean

    Const METHOD_NAME As String = "IsTransactionRowPair"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strBottomKey As String
    Dim strTopKey As String

    On Error GoTo ErrorHandler

    IsTransactionRowPair = False

    If lngTopRow < FIRST_DATA_ROW Or lngTopRow + 1 > lngLastRow Then
        GoTo ExitFunction
    End If

    strTopKey = Trim$(CStr(wksSource.Cells(lngTopRow, 1).Text))
    strBottomKey = Trim$(CStr(wksSource.Cells(lngTopRow + 1, 1).Text))

    IsTransactionRowPair = (Len(strTopKey) > 0 And Len(strBottomKey) > 0)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsTransactionRowPair = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topRow;lastRow", _
        lngTopRow, _
        lngLastRow

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet
' Returns:       Long
' Description:   Returns the last used worksheet row.
'-------------------------------------------------------------------------------
Private Function GetLastUsedRow(ByVal wksSource As Excel.Worksheet) As Long
    Const METHOD_NAME As String = "GetLastUsedRow"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngLast As Excel.Range

    On Error GoTo ErrorHandler

    GetLastUsedRow = 0

    Set rngLast = wksSource.Cells.Find( _
        What:="*", _
        After:=wksSource.Cells(1, 1), _
        LookIn:=xlFormulas, _
        LookAt:=xlPart, _
        SearchOrder:=xlByRows, _
        SearchDirection:=xlPrevious, _
        MatchCase:=False)

    If Not rngLast Is Nothing Then
        GetLastUsedRow = rngLast.Row
    End If

ExitFunction:
    Set rngLast = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GetLastUsedRow = 0

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    lngTradeCount As Long
' Returns:       Long
' Description:   Oracle pagination: first page max 11, continuation pages max 12.
'-------------------------------------------------------------------------------
Private Function GetOraclePageCount(ByVal lngTradeCount As Long) As Long

    Const METHOD_NAME As String = "GetOraclePageCount"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngRemainingTrades As Long

    On Error GoTo ErrorHandler

    If lngTradeCount <= 0 Then
        GetOraclePageCount = 0
        GoTo ExitFunction
    End If

    If lngTradeCount <= FIRST_PAGE_MAX_TRANSACTIONS Then
        GetOraclePageCount = 1
        GoTo ExitFunction
    End If

    lngRemainingTrades = lngTradeCount - FIRST_PAGE_MAX_TRANSACTIONS

    GetOraclePageCount = 1 + _
        ((lngRemainingTrades + CONTINUATION_PAGE_MAX_TRANSACTIONS - 1) \ _
        CONTINUATION_PAGE_MAX_TRANSACTIONS)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GetOraclePageCount = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "tradeCount", _
        lngTradeCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    lngTradeCount As Long, lngPage As Long, lngFirstTrade As Long, lngLastTrade As Long
' Returns:       ---
' Description:   Resolves the 1-based transaction range for one Oracle PDF page.
'-------------------------------------------------------------------------------
Private Sub GetOraclePageTradeBounds( _
    ByVal lngTradeCount As Long, _
    ByVal lngPage As Long, _
    ByRef lngFirstTrade As Long, _
    ByRef lngLastTrade As Long)

    Const METHOD_NAME As String = "GetOraclePageTradeBounds"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    lngFirstTrade = 0
    lngLastTrade = 0

    If lngTradeCount <= 0 Then
        Err.Raise 1001, METHOD_NAME, "At least one transaction is required."
    End If

    If lngPage <= 0 Then
        Err.Raise 1001, METHOD_NAME, "The page number must be greater than zero."
    End If

    If lngPage = 1 Then
        lngFirstTrade = 1
        lngLastTrade = FIRST_PAGE_MAX_TRANSACTIONS
    Else
        lngFirstTrade = FIRST_PAGE_MAX_TRANSACTIONS + 1 + _
            ((lngPage - 2) * CONTINUATION_PAGE_MAX_TRANSACTIONS)

        lngLastTrade = lngFirstTrade + _
            CONTINUATION_PAGE_MAX_TRANSACTIONS - 1
    End If

    If lngFirstTrade > lngTradeCount Then
        Err.Raise 1001, METHOD_NAME, _
            "The requested page starts beyond the available transactions."
    End If

    If lngLastTrade > lngTradeCount Then
        lngLastTrade = lngTradeCount
    End If

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    lngFirstTrade = 0
    lngLastTrade = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "tradeCount;page", _
        lngTradeCount, _
        lngPage

    errorManager.save
    Resume ExitSub
End Sub

