'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    strContent As String
' Returns:       Byte()
' Description:   Builds a valid zlib stream containing uncompressed DEFLATE stored blocks.
'-------------------------------------------------------------------------------
Private Function BuildZlibStoredBytes(ByVal strContent As String) As Byte()
    Const METHOD_NAME As String = "BuildZlibStoredBytes"
    Dim arrData() As Byte
    Dim arrOutput() As Byte
    Dim blnFinal As Boolean
    Dim dblAdler As Double
    Dim dblRemainder As Double
    Dim dblS1 As Double
    Dim dblS2 As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngBlockLength As Long
    Dim lngDataLength As Long
    Dim lngDataPosition As Long
    Dim lngIndex As Long
    Dim lngNLen As Long
    Dim lngOutputLength As Long
    Dim lngOutputPosition As Long

    On Error GoTo ErrorHandler

    arrData = StrConv(strContent, vbFromUnicode)
    lngDataLength = UBound(arrData) - LBound(arrData) + 1
    lngOutputLength = 2 + lngDataLength + (((lngDataLength + 65534) \ 65535) * 5) + 4
    ReDim arrOutput(0 To lngOutputLength - 1)

    arrOutput(0) = &H78
    arrOutput(1) = &H1
    lngOutputPosition = 2
    lngDataPosition = 0
    dblS1 = 1#
    dblS2 = 0#

    Do While lngDataPosition < lngDataLength
        lngBlockLength = lngDataLength - lngDataPosition
        If lngBlockLength > 65535 Then
            lngBlockLength = 65535
        End If

        blnFinal = (lngDataPosition + lngBlockLength >= lngDataLength)
        If blnFinal Then
            arrOutput(lngOutputPosition) = 1
        Else
            arrOutput(lngOutputPosition) = 0
        End If
        lngOutputPosition = lngOutputPosition + 1

        lngNLen = 65535 - lngBlockLength
        arrOutput(lngOutputPosition) = CByte(lngBlockLength And &HFF&)
        arrOutput(lngOutputPosition + 1) = CByte((lngBlockLength \ 256) And &HFF&)
        arrOutput(lngOutputPosition + 2) = CByte(lngNLen And &HFF&)
        arrOutput(lngOutputPosition + 3) = CByte((lngNLen \ 256) And &HFF&)
        lngOutputPosition = lngOutputPosition + 4

        For lngIndex = 0 To lngBlockLength - 1
            arrOutput(lngOutputPosition) = arrData(lngDataPosition + lngIndex)
            dblS1 = dblS1 + CDbl(arrData(lngDataPosition + lngIndex))
            If dblS1 >= 65521# Then
                dblS1 = dblS1 - 65521#
            End If
            dblS2 = dblS2 + dblS1
            dblS2 = dblS2 - (Fix(dblS2 / 65521#) * 65521#)
            lngOutputPosition = lngOutputPosition + 1
        Next lngIndex

        lngDataPosition = lngDataPosition + lngBlockLength
    Loop

    dblAdler = (dblS2 * 65536#) + dblS1
    arrOutput(lngOutputPosition) = CByte(Fix(dblAdler / 16777216#))
    dblRemainder = dblAdler - (CDbl(arrOutput(lngOutputPosition)) * 16777216#)
    arrOutput(lngOutputPosition + 1) = CByte(Fix(dblRemainder / 65536#))
    dblRemainder = dblRemainder - (CDbl(arrOutput(lngOutputPosition + 1)) * 65536#)
    arrOutput(lngOutputPosition + 2) = CByte(Fix(dblRemainder / 256#))
    arrOutput(lngOutputPosition + 3) = CByte(dblRemainder - (CDbl(arrOutput(lngOutputPosition + 2)) * 256#))

    BuildZlibStoredBytes = arrOutput

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ReDim arrOutput(0 To 0)
    BuildZlibStoredBytes = arrOutput

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "contentLength", _
        Len(strContent)

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    arrBytes() As Byte
' Returns:       String
' Description:   Encodes binary bytes using PDF ASCII85 syntax including the end marker.
'-------------------------------------------------------------------------------
Private Function Ascii85EncodeBytes(ByRef arrBytes() As Byte) As String
    Const METHOD_NAME As String = "Ascii85EncodeBytes"
    Dim arrDigits(0 To 4) As Long
    Dim dblDivisor As Double
    Dim dblValue As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAvailable As Long
    Dim lngByteCount As Long
    Dim lngDigit As Long
    Dim lngIndex As Long
    Dim lngInner As Long
    Dim lngLastIndex As Long
    Dim strEncoded As String
    Dim strGroup As String

    On Error GoTo ErrorHandler

    lngLastIndex = UBound(arrBytes)
    lngIndex = LBound(arrBytes)

    Do While lngIndex <= lngLastIndex
        lngAvailable = lngLastIndex - lngIndex + 1
        If lngAvailable > 4 Then
            lngByteCount = 4
        Else
            lngByteCount = lngAvailable
        End If

        dblValue = 0#
        For lngInner = 0 To 3
            dblValue = dblValue * 256#
            If lngInner < lngByteCount Then
                dblValue = dblValue + CDbl(arrBytes(lngIndex + lngInner))
            End If
        Next lngInner

        If lngByteCount = 4 And dblValue = 0# Then
            strEncoded = strEncoded & "z"
        Else
            strGroup = vbNullString
            For lngDigit = 4 To 0 Step -1
                dblDivisor = 85# ^ lngDigit
                arrDigits(4 - lngDigit) = CLng(Fix(dblValue / dblDivisor))
                dblValue = dblValue - (CDbl(arrDigits(4 - lngDigit)) * dblDivisor)
                strGroup = strGroup & Chr$(arrDigits(4 - lngDigit) + 33)
            Next lngDigit
            strEncoded = strEncoded & Left$(strGroup, lngByteCount + 1)
        End If

        lngIndex = lngIndex + lngByteCount
    Loop

    Ascii85EncodeBytes = strEncoded & "~>"

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Ascii85EncodeBytes = vbNullString

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

