'------------------------------------------------------------------------------
' Edit the two constants below and press F5.
'------------------------------------------------------------------------------
Public Sub RunPdfAnalysis()

    Const SRC_PDF    As String = "C:\Temp\Helaba_current.pdf"
    Const OUT_FOLDER As String = "C:\Temp"

    PdfAnalyse SRC_PDF, OUT_FOLDER

End Sub

Public Sub RunPdfAnalysisBrowse()

    Dim dialogFile As Object
    Dim pdfPath As String
    Dim outFolder As String

    Set dialogFile = Application.FileDialog(3)

    With dialogFile
        .Title = "Select the client reference PDF"
        .AllowMultiSelect = False
        .Filters.Clear
        .Filters.Add "PDF files", "*.pdf"
        If .Show <> -1 Then Exit Sub
        pdfPath = .SelectedItems(1)
    End With

    outFolder = Left$(pdfPath, InStrRev(pdfPath, "\") - 1)
    PdfAnalyse pdfPath, outFolder

End Sub

'------------------------------------------------------------------------------
' Single pass: decompress, analyse, write the three report files.
'------------------------------------------------------------------------------
Public Sub PdfAnalyse(ByVal pdfPath As String, ByVal outFolder As String)

    Dim baseName As String
    Dim pathStreams As String, pathLayout As String, pathSpec As String, pathCells As String
    Dim pathOracle As String
    Dim fStreams As Integer, fLayout As Integer, fSpec As Integer, fCells As Integer
    Dim fOracle As Integer
    Dim pageRefs As String
    Dim refs() As String
    Dim i As Long, objIdx As Long
    Dim pageDict As String, content As String
    Dim pageCount As Long
    Dim pageTradeCount As Long
    Dim maxTradeCount As Long
    Dim totalPageCount As Long

    m_pdf = ReadBytes(pdfPath)
    BuildObjectIndex

    If Right$(outFolder, 1) <> "\" Then outFolder = outFolder & "\"
    baseName = FileBaseName(pdfPath)
    pathStreams = outFolder & baseName & "_streams.txt"
    pathLayout = outFolder & baseName & "_layout.txt"
    pathSpec = outFolder & baseName & "_spec.txt"
    pathCells = outFolder & baseName & "_columns.txt"
    pathOracle = outFolder & baseName & "_oracle_schema.txt"

    fStreams = OpenNew(pathStreams)
    fLayout = OpenNew(pathLayout)
    fSpec = OpenNew(pathSpec)
    fCells = OpenNew(pathCells)
    fOracle = OpenNew(pathOracle)

    EmitLine fCells, "TABLE GEOMETRY - human readable cell map"
    EmitLine fCells, "source : " & pdfPath
    EmitLine fCells, "units  : PDF points (1/72 inch), origin bottom-left"

    WriteHeaders fStreams, fLayout, fSpec, pdfPath
    WriteOracleSchemaHeader fOracle, pdfPath

    '--- pass 1: raw decompressed streams --------------------------------------
    DumpAllStreams fStreams

    '--- pass 2: per page geometry ---------------------------------------------
    pageRefs = PageObjectOrder()
    If Len(pageRefs) = 0 Then
        EmitLine fLayout, "*** no /Type/Page objects found ***"
        EmitLine fSpec, "*** no /Type/Page objects found ***"
        EmitLine fOracle, "ERROR|no /Type/Page objects found"
    Else
        refs = Split(pageRefs, ",")
        totalPageCount = UBound(refs) - LBound(refs) + 1
        For i = LBound(refs) To UBound(refs)
            objIdx = IndexOfObject(CLng(refs(i)))
            If objIdx >= 0 Then
                pageCount = pageCount + 1
                pageDict = ObjectDict(m_objPos(objIdx))
                content = PageContent(pageDict)
                ResetCollectors
                AnalyseContent content
                EmitLayoutFull fLayout, pageCount, CLng(refs(i)), pageDict, Len(content)
                EmitSpecShort fSpec, pageCount, CLng(refs(i)), pageDict, Len(content)
                EmitCellMap fCells, pageCount, CLng(refs(i)), pageDict
                pageTradeCount = EmitOraclePageSchema( _
                    fOracle, _
                    pageCount, _
                    CLng(refs(i)), _
                    pageDict, _
                    totalPageCount)
                If pageTradeCount > maxTradeCount Then maxTradeCount = pageTradeCount
            End If
        Next i
    End If

    EmitLine fOracle, ""
    EmitLine fOracle, "DOCUMENT|pages=" & CStr(pageCount) & "|maxTradesOnPage=" & CStr(maxTradeCount)

    Close #fStreams
    Close #fLayout
    Close #fSpec
    Close #fCells
    Close #fOracle

    MsgBox "Done - " & CStr(pageCount) & " page(s) analysed." & vbCrLf & vbCrLf & _
           "1) " & pathStreams & vbCrLf & _
           "2) " & pathLayout & vbCrLf & _
           "3) " & pathSpec & vbCrLf & _
           "4) " & pathCells & vbCrLf & _
           "5) " & pathOracle & "   <- send this file", _
           vbInformation, "modPdfReport"

End Sub

'------------------------------------------------------------------------------
Private Sub WriteHeaders(ByVal fStreams As Integer, ByVal fLayout As Integer, _
                         ByVal fSpec As Integer, ByVal pdfPath As String)

    Dim info As String
    info = "source: " & pdfPath & "   size: " & CStr(UBound(m_pdf) + 1) & " bytes"

    EmitLine fStreams, "PDF STREAM DUMP - decompressed page operators"
    EmitLine fStreams, info
    EmitLine fStreams, String$(78, "=")

    EmitLine fLayout, "PDF LAYOUT - full coordinate lists"
    EmitLine fLayout, info
    EmitLine fLayout, "units: PDF points (1/72 inch), origin bottom-left, absolute coordinates"
    EmitLine fLayout, String$(78, "=")

    EmitLine fSpec, "PDF LAYOUT - short specification"
    EmitLine fSpec, info
    EmitLine fSpec, "units: PDF points (1/72 inch), origin bottom-left"
    EmitLine fSpec, String$(72, "=")

End Sub


'==============================================================================
' REPORT 1 - RAW STREAMS
'==============================================================================

Private Sub DumpAllStreams(ByVal fileNum As Integer)

    Dim i As Long
    Dim dict As String
    Dim dStart As Long, dEnd As Long
    Dim plain() As Byte
    Dim plainLen As Long
    Dim errText As String
    Dim count As Long

    For i = 0 To m_objCount - 1
        dict = ObjectDict(m_objPos(i))

        If StreamBounds(m_objPos(i), dStart, dEnd) Then
            count = count + 1
            EmitLine fileNum, ""
            EmitLine fileNum, String$(78, "-")
            EmitLine fileNum, "obj " & CStr(m_objNum(i)) & "  " & Trim$(dict)
            EmitLine fileNum, "raw stream bytes: " & CStr(dEnd - dStart + 1)
            EmitLine fileNum, String$(78, "-")

            If InStr(1, dict, "/DCTDecode") > 0 Then
                EmitLine fileNum, "*** JPEG image stream - binary, not dumped ***"
            ElseIf InStr(1, dict, "/FlateDecode") > 0 Then
                If TryInflate(m_pdf, dStart + ZlibSkip(dStart), dEnd, plain, plainLen, errText) Then
                    WriteRaw fileNum, plain, plainLen
                    EmitLine fileNum, ""
                Else
                    EmitLine fileNum, "*** inflate failed: " & errText & " ***"
                End If
            Else
                EmitLine fileNum, "*** uncompressed stream ***"
                EmitLine fileNum, BytesText(m_pdf, dStart, dEnd)
            End If
        End If
    Next i

    EmitLine fileNum, ""
    EmitLine fileNum, String$(78, "=")
    EmitLine fileNum, "streams processed: " & CStr(count)

End Sub


