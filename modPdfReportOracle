            EmitLine fileNum, "  ... " & CStr(baseN - 4) & " further baselines, same pattern"
            Exit For
        End If
        EmitLine fileNum, "  y=" & NumTxt(baseY(i)) & "  " & RowContent(baseY(i))
    Next i
    EmitLine fileNum, ""

    EmitLine fileNum, "FILLS (x y w h) : " & RectSummary()
    EmitLine fileNum, "IMAGES          : " & JoinCollection(m_images, " | ")

End Sub

'------------------------------------------------------------------------------
Private Function RowContent(ByVal y As Double) As String

    Dim idx() As Long
    Dim n As Long, i As Long, j As Long, t As Long
    Dim s As String

    ReDim idx(0 To m_txN)
    For i = 0 To m_txN - 1
        If Abs(m_txY(i) - y) <= TOL Then
            idx(n) = i
            n = n + 1
        End If
    Next i
    If n = 0 Then Exit Function

    For i = 0 To n - 2
        For j = i + 1 To n - 1
            If m_txX(idx(j)) < m_txX(idx(i)) Then
                t = idx(i): idx(i) = idx(j): idx(j) = t
            End If
        Next j
    Next i

    For i = 0 To n - 1
        If i >= MAX_ROW_ITEMS Then
            s = s & "...(+" & CStr(n - MAX_ROW_ITEMS) & ")"
            Exit For
        End If
        s = s & NumTxt(m_txX(idx(i))) & ":" & Left$(m_txStr(idx(i)), 22) & " | "
    Next i

    RowContent = s

End Function

'------------------------------------------------------------------------------
' Rectangles collapsed to distinct width x height shapes with a count.
'------------------------------------------------------------------------------
Private Function RectSummary() As String

    Dim shapes As Collection
    Dim counts As Collection
    Dim key As String
    Dim i As Long, k As Long
    Dim found As Boolean
    Dim s As String

    If m_recN = 0 Then
        RectSummary = "(none)"
        Exit Function
    End If

    Set shapes = New Collection
    Set counts = New Collection

    For i = 0 To m_recN - 1
        key = NumTxt(m_recW(i)) & " x " & NumTxt(m_recH(i))
        found = False
        For k = 1 To shapes.count
            If shapes.Item(k) = key Then
                counts.Add counts.Item(k) + 1
                counts.Remove k
                found = True
                Exit For
            End If
        Next k
        If Not found Then
            shapes.Add key
            counts.Add 1
        End If
    Next i

    For k = 1 To shapes.count
        s = s & shapes.Item(k) & " x" & CStr(counts.Item(k)) & " | "
    Next k

    s = s & "  first at " & NumTxt(m_recX(0)) & "," & NumTxt(m_recY(0))
    RectSummary = s

End Function


