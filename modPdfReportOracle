Private Sub WriteOracleSchemaHeader(ByVal fileNum As Integer, ByVal pdfPath As String)

    Dim topX() As Double
    Dim topW() As Double
    Dim bottomX() As Double
    Dim bottomW() As Double

    FillOracleTopGrid topX, topW
    FillOracleBottomGrid bottomX, bottomW

    EmitLine fileNum, "TRADEVERSAND ORACLE PDF SCHEMA V1"
    EmitLine fileNum, "SOURCE|" & pdfPath
    EmitLine fileNum, "UNITS|PDF points|origin=bottom-left"
    EmitLine fileNum, "EXPECTED|MediaBox=0,0,1368,684|orientation=landscape|firstPageMaxTrades=11|continuationPageMaxTrades=12"
    EmitLine fileNum, "EXPECTED_TOP_COLUMNS|12"
    EmitLine fileNum, "EXPECTED_TOP_X|" & OracleJoinDoubles(topX, ORACLE_TOP_COLUMN_COUNT)
    EmitLine fileNum, "EXPECTED_TOP_W|" & OracleJoinDoubles(topW, ORACLE_TOP_COLUMN_COUNT)
    EmitLine fileNum, "EXPECTED_BOTTOM_COLUMNS|13"
    EmitLine fileNum, "EXPECTED_BOTTOM_X|" & OracleJoinDoubles(bottomX, ORACLE_BOTTOM_COLUMN_COUNT)
    EmitLine fileNum, "EXPECTED_BOTTOM_W|" & OracleJoinDoubles(bottomW, ORACLE_BOTTOM_COLUMN_COUNT)

End Sub

Private Function OracleMaxTradesForPage(ByVal pageNo As Long) As Long

    If pageNo = 1 Then
        OracleMaxTradesForPage = ORACLE_FIRST_PAGE_MAX_TRADES
    Else
        OracleMaxTradesForPage = ORACLE_CONTINUATION_PAGE_MAX_TRADES
    End If
End Function

Private Function EmitOraclePageSchema(ByVal fileNum As Integer, ByVal pageNo As Long, _
                                      ByVal objNo As Long, ByVal pageDict As String, _
                                      ByVal totalPages As Long) As Long

    Dim topX() As Double
    Dim topW() As Double
    Dim bottomX() As Double
    Dim bottomW() As Double
    Dim topHeaderY As Double
    Dim bottomHeaderY As Double
    Dim frameX As Double
    Dim frameY As Double
    Dim frameW As Double
    Dim frameH As Double
    Dim topTradeY() As Double
    Dim bottomTradeY() As Double
    Dim tradeCount As Long
    Dim dataBaselineCount As Long
    Dim unpairedRows As Long
    Dim hRuleCount As Long
    Dim vRuleCount As Long
    Dim i As Long
    Dim pageType As String
    Dim topLabels As String
    Dim bottomLabels As String
    Dim topLabelX As String
    Dim bottomLabelX As String
    Dim topGridCheck As String
    Dim bottomGridCheck As String
    Dim footerText As String
    Dim footerX As Double
    Dim footerY As Double
    Dim footerFound As Boolean
    Dim footerExpected As Boolean
    Dim headerMatch As Boolean
    Dim gridMatch As Boolean
    Dim tradePairMatch As Boolean
    Dim tradeLimitMatch As Boolean
    Dim footerMatch As Boolean
    Dim layoutResult As String

    FillOracleTopGrid topX, topW
    FillOracleBottomGrid bottomX, bottomW

    FindOracleTableFrame frameX, frameY, frameW, frameH
    topHeaderY = FindOracleTextBaseline("DEPOTNR")
    bottomHeaderY = FindOracleTextBaseline("TRANSAKTIONSNR")

    If pageNo = 1 Then
        pageType = "FIRST"
    Else
        pageType = "CONTINUATION"
    End If

    EmitLine fileNum, ""
    EmitLine fileNum, "PAGE|" & CStr(pageNo) & "|object=" & CStr(objNo) & "|type=" & pageType
    EmitLine fileNum, "PAGE_DICTIONARY|MediaBox=" & OracleCleanText(DictValue(pageDict, "/MediaBox")) & _
                           "|Rotate=" & OracleCleanText(DictValue(pageDict, "/Rotate")) & _
                           "|Fonts=" & OracleCleanText(FontMap(pageDict))
    EmitLine fileNum, "FRAME|x=" & NumTxt(frameX) & "|y=" & NumTxt(frameY) & _
                           "|w=" & NumTxt(frameW) & "|h=" & NumTxt(frameH) & _
                           "|right=" & NumTxt(frameX + frameW) & "|top=" & NumTxt(frameY + frameH)
    EmitLine fileNum, "IMAGE|" & OracleCleanText(JoinCollection(m_images, " ; "))
    EmitLine fileNum, "FULL_WIDTH_Y|" & OracleFullWidthYRules()

    topLabels = OracleRowValues(topHeaderY, topX, topW, ORACLE_TOP_COLUMN_COUNT, False)
    bottomLabels = OracleRowValues(bottomHeaderY, bottomX, bottomW, ORACLE_BOTTOM_COLUMN_COUNT, False)
    topLabelX = OracleRowAnchors(topHeaderY, topX, topW, ORACLE_TOP_COLUMN_COUNT)
    bottomLabelX = OracleRowAnchors(bottomHeaderY, bottomX, bottomW, ORACLE_BOTTOM_COLUMN_COUNT)

    EmitLine fileNum, "HEADER_TOP|baseline=" & NumTxt(topHeaderY) & _
                           "|band=" & OracleFullWidthBand(topHeaderY) & _
                           "|labels=" & topLabels & "|textX=" & topLabelX
    EmitLine fileNum, "HEADER_BOTTOM|baseline=" & NumTxt(bottomHeaderY) & _
                           "|band=" & OracleFullWidthBand(bottomHeaderY) & _
                           "|labels=" & bottomLabels & "|textX=" & bottomLabelX

    topGridCheck = OracleGridCheck(topX, topW, ORACLE_TOP_COLUMN_COUNT)
    bottomGridCheck = OracleGridCheck(bottomX, bottomW, ORACLE_BOTTOM_COLUMN_COUNT)
    EmitLine fileNum, "TOP_GRID_CHECK|" & topGridCheck
    EmitLine fileNum, "BOTTOM_GRID_CHECK|" & bottomGridCheck

    tradeCount = CollectOracleTradeBaselines(bottomHeaderY, frameY, topTradeY, bottomTradeY)
    dataBaselineCount = CountOracleDataBaselines(bottomHeaderY, frameY)
    unpairedRows = dataBaselineCount - (tradeCount * 2)
    If unpairedRows < 0 Then unpairedRows = 0

    EmitLine fileNum, "TRADES|count=" & CStr(tradeCount) & _
                           "|topBaselines=" & OracleJoinDoubles(topTradeY, tradeCount) & _
                           "|bottomBaselines=" & OracleJoinDoubles(bottomTradeY, tradeCount) & _
                           "|pitches=" & OracleTradePitches(topTradeY, tradeCount) & _
                           "|dataBaselines=" & CStr(dataBaselineCount) & _
                           "|unpairedRows=" & CStr(unpairedRows)

    For i = 0 To tradeCount - 1
        EmitLine fileNum, "TRADE|" & Format$(i + 1, "00") & _
                               "|topY=" & NumTxt(topTradeY(i)) & _
                               "|topBand=" & OracleFullWidthBand(topTradeY(i)) & _
                               "|bottomY=" & NumTxt(bottomTradeY(i)) & _
                               "|bottomBand=" & OracleFullWidthBand(bottomTradeY(i))
        EmitLine fileNum, "TOP|" & OracleRowValues(topTradeY(i), topX, topW, ORACLE_TOP_COLUMN_COUNT, True)
        EmitLine fileNum, "BOTTOM|" & OracleRowValues(bottomTradeY(i), bottomX, bottomW, ORACLE_BOTTOM_COLUMN_COUNT, True)
    Next i

    footerFound = FindOracleFooter(footerText, footerX, footerY)
    footerExpected = (pageNo = totalPages)

    If footerFound Then
        EmitLine fileNum, "FOOTER|x=" & NumTxt(footerX) & "|y=" & NumTxt(footerY) & _
                               "|text=" & OracleCleanText(footerText)
    Else
        EmitLine fileNum, "FOOTER|(none)"
    End If

    hRuleCount = OracleClusteredRuleCount(False)
    vRuleCount = OracleClusteredRuleCount(True)

    EmitLine fileNum, "PAGE_FINGERPRINT|textRuns=" & CStr(m_txN) & _
                           "|segments=" & CStr(m_segN) & _
                           "|rectangles=" & CStr(m_recN) & _
                           "|hRules=" & CStr(hRuleCount) & _
                           "|vRules=" & CStr(vRuleCount) & _
                           "|fullWidthY=" & OracleFullWidthYRules() & _
                           "|topHeaderY=" & NumTxt(topHeaderY) & _
                           "|bottomHeaderY=" & NumTxt(bottomHeaderY) & _
                           "|trades=" & CStr(tradeCount) & _
                           "|unpairedRows=" & CStr(unpairedRows) & _
                           "|footer=" & UCase$(CStr(footerFound))

    headerMatch = (topHeaderY <> 0 And bottomHeaderY <> 0)
    gridMatch = _
        InStr(1, topGridCheck, "match=TRUE", vbTextCompare) > 0 And _
        InStr(1, bottomGridCheck, "match=TRUE", vbTextCompare) > 0
    tradePairMatch = (unpairedRows = 0)
    tradeLimitMatch = (tradeCount <= OracleMaxTradesForPage(pageNo))
    footerMatch = (footerFound = footerExpected)

    If headerMatch And gridMatch And tradePairMatch And tradeLimitMatch And footerMatch Then
        layoutResult = "PASS"
    Else
        layoutResult = "WARN"
    End If

    EmitLine fileNum, "PAGE_LAYOUT_CHECK|header=" & UCase$(CStr(headerMatch)) & _
                           "|grid=" & UCase$(CStr(gridMatch)) & _
                           "|tradePairs=" & UCase$(CStr(tradePairMatch)) & _
                           "|maxTrades=" & UCase$(CStr(tradeLimitMatch)) & _
                           "|expectedMaxTrades=" & CStr(OracleMaxTradesForPage(pageNo)) & _
                           "|footerExpected=" & UCase$(CStr(footerExpected)) & _
                           "|footerFound=" & UCase$(CStr(footerFound)) & _
                           "|footerMatch=" & UCase$(CStr(footerMatch)) & _
                           "|result=" & layoutResult

    If Not headerMatch Then
        EmitLine fileNum, "WARNING|header baseline not detected"
    End If
    If Not gridMatch Then
        EmitLine fileNum, "WARNING|top or bottom Oracle grid does not match expected coordinates"
    End If
    If Not tradePairMatch Then
        EmitLine fileNum, "WARNING|unpaired data baseline detected - possible split or malformed two-row transaction"
    End If
    If Not tradeLimitMatch Then
        EmitLine fileNum, "WARNING|trade count exceeds expected maximum " & CStr(OracleMaxTradesForPage(pageNo))
    End If
    If Not footerMatch Then
        EmitLine fileNum, "WARNING|footer placement does not match last-page-only Oracle convention"
    End If

    EmitOraclePageSchema = tradeCount

End Function

