Private Sub FindOracleTableFrame(ByRef x As Double, ByRef y As Double, _
                                 ByRef w As Double, ByRef h As Double)

    Dim i As Long
    Dim area As Double
    Dim bestArea As Double
    Dim bestIndex As Long

    bestArea = -1#
    bestIndex = -1

    For i = 0 To m_recN - 1
        area = Abs(m_recW(i)) * Abs(m_recH(i))
        If area > bestArea Then
            bestArea = area
            bestIndex = i
        End If
    Next i

    If bestIndex >= 0 Then
        x = m_recX(bestIndex)
        y = m_recY(bestIndex)
        w = m_recW(bestIndex)
        h = m_recH(bestIndex)
    End If

End Sub

Private Function FindOracleTextBaseline(ByVal normalizedNeedle As String) As Double

    Dim i As Long
    Dim normalizedText As String

    For i = 0 To m_txN - 1
        normalizedText = NormalizeOracleLabel(m_txStr(i))
        If normalizedText = normalizedNeedle Then
            FindOracleTextBaseline = m_txY(i)
            Exit Function
        End If
    Next i

End Function

Private Function CollectOracleTradeBaselines(ByVal bottomHeaderY As Double, _
                                             ByVal frameBottomY As Double, _
                                             ByRef topY() As Double, _
                                             ByRef bottomY() As Double) As Long

    Dim allY() As Double
    Dim dataY() As Double
    Dim allCount As Long
    Dim dataCount As Long
    Dim i As Long
    Dim stepY As Double
    Dim tradeCount As Long

    allCount = ClusterValues(m_txY, m_txN, allY, False)
    ReDim dataY(0 To allCount)

    For i = 0 To allCount - 1
        If allY(i) < bottomHeaderY - TOL And allY(i) > frameBottomY + TOL Then
            If HasOracleDataText(allY(i)) Then
                dataY(dataCount) = allY(i)
                dataCount = dataCount + 1
            End If
        End If
    Next i

    ReDim topY(0 To dataCount)
    ReDim bottomY(0 To dataCount)

    i = 0
    Do While i + 1 < dataCount
        stepY = dataY(i) - dataY(i + 1)
        If stepY >= ORACLE_MIN_DATA_ROW_STEP And stepY <= ORACLE_MAX_DATA_ROW_STEP Then
            topY(tradeCount) = dataY(i)
            bottomY(tradeCount) = dataY(i + 1)
            tradeCount = tradeCount + 1
            i = i + 2
        Else
            i = i + 1
        End If
    Loop

    If tradeCount = 0 Then
        ReDim topY(0 To 0)
        ReDim bottomY(0 To 0)
    Else
        ReDim Preserve topY(0 To tradeCount - 1)
        ReDim Preserve bottomY(0 To tradeCount - 1)
    End If

    CollectOracleTradeBaselines = tradeCount

End Function

Private Function HasOracleDataText(ByVal baselineY As Double) As Boolean

    Dim i As Long

    For i = 0 To m_txN - 1
        If Abs(m_txY(i) - baselineY) <= TOL Then
            If m_txX(i) >= ORACLE_TABLE_LEFT_X - TOL And _
               m_txX(i) <= ORACLE_TABLE_RIGHT_X + TOL Then
                If UCase$(m_txFont(i)) = "/F1" Then
                    HasOracleDataText = True
                    Exit Function
                End If
            End If
        End If
    Next i

End Function

Private Function OracleRowValues(ByVal baselineY As Double, ByRef x() As Double, _
                                 ByRef w() As Double, ByVal count As Long, _
                                 ByVal includeAnchor As Boolean) As String

    Dim i As Long
    Dim cellText As String
    Dim anchorX As Double
    Dim result As String

    For i = 0 To count - 1
        cellText = OracleCellText(baselineY, x(i), w(i), anchorX)
        If Len(cellText) = 0 Then cellText = "-"

        If includeAnchor And anchorX >= 0 Then
            result = result & NumTxt(anchorX) & ":" & OracleCleanText(cellText)
        Else
            result = result & OracleCleanText(cellText)
        End If

        If i < count - 1 Then result = result & "|"
    Next i

    OracleRowValues = result

End Function

Private Function OracleRowAnchors(ByVal baselineY As Double, ByRef x() As Double, _
                                  ByRef w() As Double, ByVal count As Long) As String

    Dim i As Long
    Dim anchorX As Double
    Dim cellText As String
    Dim result As String

    For i = 0 To count - 1
        cellText = OracleCellText(baselineY, x(i), w(i), anchorX)
        If anchorX < 0 Then
            result = result & "-"
        Else
            result = result & NumTxt(anchorX)
        End If
        If i < count - 1 Then result = result & "|"
    Next i

    OracleRowAnchors = result

End Function

Private Function OracleCellText(ByVal baselineY As Double, ByVal cellX As Double, _
                                ByVal cellW As Double, ByRef firstAnchorX As Double) As String

    Dim idx() As Long
    Dim count As Long
    Dim i As Long
    Dim j As Long
    Dim swapIndex As Long
    Dim rightX As Double
    Dim result As String

    firstAnchorX = -1#
    rightX = cellX + cellW
    ReDim idx(0 To m_txN)

    For i = 0 To m_txN - 1
        If Abs(m_txY(i) - baselineY) <= TOL Then
            If m_txX(i) >= cellX - TOL And m_txX(i) < rightX + TOL Then
                idx(count) = i
                count = count + 1
            End If
        End If
    Next i

    For i = 0 To count - 2
        For j = i + 1 To count - 1
            If m_txX(idx(j)) < m_txX(idx(i)) Then
                swapIndex = idx(i)
                idx(i) = idx(j)
                idx(j) = swapIndex
            End If
        Next j
    Next i

    For i = 0 To count - 1
        If firstAnchorX < 0 Then firstAnchorX = m_txX(idx(i))
        If Len(result) > 0 Then result = result & " ~ "
        result = result & m_txStr(idx(i))
    Next i

    OracleCellText = result

End Function

Private Function OracleGridCheck(ByRef x() As Double, ByRef w() As Double, _
                                 ByVal count As Long) As String

    Dim rules() As Double
    Dim ruleCount As Long
    Dim i As Long
    Dim expectedX As Double
    Dim nearestX As Double
    Dim deltaX As Double
    Dim result As String
    Dim allMatch As Boolean

    ruleCount = ClusterValues(m_vRuleX, m_vRuleN, rules, True)
    allMatch = True

    For i = 0 To count
        If i < count Then
            expectedX = x(i)
        Else
            expectedX = x(count - 1) + w(count - 1)
        End If

        nearestX = NearestOracleRule(expectedX, rules, ruleCount)
        deltaX = nearestX - expectedX
        If Abs(deltaX) > ORACLE_GRID_MATCH_TOLERANCE Then allMatch = False

        If Len(result) > 0 Then result = result & ";"
        result = result & NumTxt(expectedX) & ">" & NumTxt(nearestX) & "(" & NumTxt(deltaX) & ")"
    Next i

    OracleGridCheck = "match=" & UCase$(CStr(allMatch)) & "|rules=" & result

End Function

Private Function NearestOracleRule(ByVal expectedX As Double, ByRef rules() As Double, _
                                   ByVal ruleCount As Long) As Double

    Dim i As Long
    Dim bestDistance As Double
    Dim distance As Double

    bestDistance = 1E+30
    NearestOracleRule = expectedX

    For i = 0 To ruleCount - 1
        distance = Abs(rules(i) - expectedX)
        If distance < bestDistance Then
            bestDistance = distance
            NearestOracleRule = rules(i)
        End If
    Next i

End Function

Private Function OracleFullWidthYRules() As String

    Dim rawY() As Double
    Dim clusteredY() As Double
    Dim rawCount As Long
    Dim clusteredCount As Long
    Dim i As Long

    ReDim rawY(0 To m_segN * 2 + m_recN * 2 + 10)

    For i = 0 To m_segN - 1
        If Abs(m_segY1(i) - m_segY2(i)) <= TOL Then
            If Abs(m_segX2(i) - m_segX1(i)) >= 1200# Then
                rawY(rawCount) = m_segY1(i)
                rawCount = rawCount + 1
            End If
        End If
    Next i

    For i = 0 To m_recN - 1
        If Abs(m_recW(i)) >= 1200# Then
            rawY(rawCount) = m_recY(i)
            rawCount = rawCount + 1
            rawY(rawCount) = m_recY(i) + m_recH(i)
            rawCount = rawCount + 1
        End If
    Next i

    clusteredCount = ClusterValues(rawY, rawCount, clusteredY, False)
    OracleFullWidthYRules = OracleJoinDoubles(clusteredY, clusteredCount)

End Function

Private Function OracleFullWidthBand(ByVal baselineY As Double) As String

    Dim rawY() As Double
    Dim clusteredY() As Double
    Dim rawCount As Long
    Dim clusteredCount As Long
    Dim i As Long
    Dim topY As Double
    Dim bottomY As Double

    ReDim rawY(0 To m_segN * 2 + m_recN * 2 + 10)

    For i = 0 To m_segN - 1
        If Abs(m_segY1(i) - m_segY2(i)) <= TOL Then
            If Abs(m_segX2(i) - m_segX1(i)) >= 1200# Then
                rawY(rawCount) = m_segY1(i)
                rawCount = rawCount + 1
            End If
        End If
    Next i

    For i = 0 To m_recN - 1
        If Abs(m_recW(i)) >= 1200# Then
            rawY(rawCount) = m_recY(i)
            rawCount = rawCount + 1
            rawY(rawCount) = m_recY(i) + m_recH(i)
            rawCount = rawCount + 1
        End If
    Next i

    clusteredCount = ClusterValues(rawY, rawCount, clusteredY, False)

    For i = 0 To clusteredCount - 1
        If clusteredY(i) > baselineY + TOL Then
            If topY = 0 Or clusteredY(i) < topY Then topY = clusteredY(i)
        ElseIf clusteredY(i) < baselineY - TOL Then
            If bottomY = 0 Or clusteredY(i) > bottomY Then bottomY = clusteredY(i)
        End If
    Next i

    If topY = 0 Or bottomY = 0 Then
        OracleFullWidthBand = "(not detected)"
    Else
        OracleFullWidthBand = NumTxt(bottomY) & ".." & NumTxt(topY) & _
                              ",h=" & NumTxt(topY - bottomY)
    End If

End Function

Private Function OracleTradePitches(ByRef topY() As Double, ByVal count As Long) As String

    Dim i As Long
    Dim result As String

    If count <= 1 Then
        OracleTradePitches = "(none)"
        Exit Function
    End If

    For i = 0 To count - 2
        result = result & NumTxt(topY(i) - topY(i + 1))
        If i < count - 2 Then result = result & "|"
    Next i

    OracleTradePitches = result

End Function

Private Function FindOracleFooter(ByRef footerText As String, ByRef footerX As Double, _
                                  ByRef footerY As Double) As Boolean

    Dim i As Long
    Dim normalizedText As String

    For i = 0 To m_txN - 1
        normalizedText = UCase$(m_txStr(i))
        If InStr(1, normalizedText, "DIESE ABRECHNUNG") > 0 Then
            footerText = m_txStr(i)
            footerX = m_txX(i)
            footerY = m_txY(i)
            FindOracleFooter = True
            Exit Function
        End If
    Next i

End Function

Private Function NormalizeOracleLabel(ByVal value As String) As String

    Dim i As Long
    Dim ch As String
    Dim result As String

    value = UCase$(Trim$(value))

    For i = 1 To Len(value)
        ch = Mid$(value, i, 1)
        If (ch >= "A" And ch <= "Z") Or (ch >= "0" And ch <= "9") Then
            result = result & ch
        End If
    Next i

    NormalizeOracleLabel = result

End Function

Private Function OracleCleanText(ByVal value As String) As String

    value = Replace(value, vbCr, " ")
    value = Replace(value, vbLf, " ")
    value = Replace(value, "|", "/")
    value = Replace(value, "~", "-")

    Do While InStr(value, "  ") > 0
        value = Replace(value, "  ", " ")
    Loop

    OracleCleanText = Trim$(value)

End Function

Private Function OracleJoinDoubles(ByRef values() As Double, ByVal count As Long) As String

    Dim i As Long
    Dim result As String

    If count <= 0 Then
        OracleJoinDoubles = "(none)"
        Exit Function
    End If

    For i = 0 To count - 1
        result = result & NumTxt(values(i))
        If i < count - 1 Then result = result & "|"
    Next i

    OracleJoinDoubles = result

End Function


'------------------------------------------------------------------------------
' Counts text baselines in the Oracle data area. Used to detect split/odd rows
' that CollectOracleTradeBaselines cannot pair into normal two-row trades.
'------------------------------------------------------------------------------
Private Function CountOracleDataBaselines(ByVal bottomHeaderY As Double, _
                                          ByVal frameBottomY As Double) As Long

    Dim allY() As Double
    Dim allCount As Long
    Dim i As Long

    allCount = ClusterValues(m_txY, m_txN, allY, False)

    For i = 0 To allCount - 1
        If allY(i) < bottomHeaderY - TOL And allY(i) > frameBottomY + TOL Then
            If HasOracleDataText(allY(i)) Then
                CountOracleDataBaselines = CountOracleDataBaselines + 1
            End If
        End If
    Next i

End Function

'------------------------------------------------------------------------------
' Returns the number of distinct clustered horizontal or vertical grid rules.
'------------------------------------------------------------------------------
Private Function OracleClusteredRuleCount(ByVal verticalRules As Boolean) As Long

    Dim values() As Double

    If verticalRules Then
        OracleClusteredRuleCount = ClusterValues(m_vRuleX, m_vRuleN, values, True)
    Else
        OracleClusteredRuleCount = ClusterValues(m_hRuleY, m_hRuleN, values, False)
    End If

End Function

'==============================================================================
' DEFLATE DECODER
'==============================================================================

Public Function InflateStream(ByRef srcData() As Byte, ByVal fromIdx As Long, _
                              ByVal toIdx As Long, ByRef destData() As Byte) As Long

    Dim isLast As Long, blockType As Long
    Dim litHuff As tHuffman, distHuff As tHuffman
    Dim i As Long

    InitTables

    m_in = srcData
    m_inPos = fromIdx
    m_inEnd = toIdx
    m_bitBuf = 0
    m_bitCnt = 0
    m_outCap = 65536
    ReDim m_out(0 To m_outCap - 1)
    m_outLen = 0

    Do
        isLast = GetBits(1)
        blockType = GetBits(2)

        Select Case blockType
            Case 0
                InflateStored
            Case 1
                BuildFixedTables litHuff, distHuff
                InflateCodes litHuff, distHuff
            Case 2
                BuildDynamicTables litHuff, distHuff
                InflateCodes litHuff, distHuff
            Case Else
                Err.Raise ERR_BASE + 1, "InflateStream", "Invalid DEFLATE block type"
        End Select
    Loop While isLast = 0

    If m_outLen = 0 Then
        ReDim destData(0 To 0)
    Else
        ReDim destData(0 To m_outLen - 1)
        For i = 0 To m_outLen - 1
            destData(i) = m_out(i)
        Next i
    End If

    InflateStream = m_outLen

End Function

'------------------------------------------------------------------------------
Private Function TryInflate(ByRef srcData() As Byte, ByVal fromIdx As Long, _
                            ByVal toIdx As Long, ByRef destData() As Byte, _
                            ByRef outLen As Long, ByRef errText As String) As Boolean

    On Error GoTo ErrHandler

    errText = vbNullString
    outLen = InflateStream(srcData, fromIdx, toIdx, destData)
    TryInflate = True
    Exit Function

ErrHandler:
    errText = Err.Description
    outLen = 0
    TryInflate = False

End Function

'------------------------------------------------------------------------------
Private Sub InflateStored()

    Dim blockLen As Long, i As Long

    m_bitBuf = 0
    m_bitCnt = 0

    If m_inPos + 3 > m_inEnd Then
        Err.Raise ERR_BASE + 2, "InflateStored", "Truncated stored block"
    End If

    blockLen = CLng(m_in(m_inPos)) + CLng(m_in(m_inPos + 1)) * 256
    m_inPos = m_inPos + 4

    For i = 1 To blockLen
        If m_inPos > m_inEnd Then
            Err.Raise ERR_BASE + 3, "InflateStored", "Stored block runs past end of data"
        End If
        OutByte m_in(m_inPos)
        m_inPos = m_inPos + 1
    Next i

End Sub

'------------------------------------------------------------------------------
Private Sub InflateCodes(ByRef litHuff As tHuffman, ByRef distHuff As tHuffman)

    Dim symbol As Long, matchLen As Long, dist As Long, i As Long

    Do
        symbol = HuffDecode(litHuff)

        If symbol < 256 Then
            OutByte CByte(symbol)

        ElseIf symbol = 256 Then
            Exit Do

        Else
            symbol = symbol - 257
            If symbol >= 29 Then
                Err.Raise ERR_BASE + 4, "InflateCodes", "Invalid length code"
            End If
            matchLen = m_lenBase(symbol) + GetBits(m_lenExtra(symbol))

            symbol = HuffDecode(distHuff)
            If symbol > 29 Then
                Err.Raise ERR_BASE + 5, "InflateCodes", "Invalid distance code"
            End If
            dist = m_distBase(symbol) + GetBits(m_distExtra(symbol))
            If dist > m_outLen Then
                Err.Raise ERR_BASE + 6, "InflateCodes", "Distance points before start of output"
            End If

            For i = 1 To matchLen
                OutByte m_out(m_outLen - dist)           ' overlapping copy is intentional
            Next i
        End If
    Loop

End Sub

'------------------------------------------------------------------------------
Private Sub BuildFixedTables(ByRef litHuff As tHuffman, ByRef distHuff As tHuffman)

    Dim lengths(0 To FIXED_LIT - 1) As Long
    Dim distLengths(0 To MAX_DIST_CODES - 1) As Long
    Dim i As Long

    For i = 0 To 143:   lengths(i) = 8: Next i
    For i = 144 To 255: lengths(i) = 9: Next i
    For i = 256 To 279: lengths(i) = 7: Next i
    For i = 280 To 287: lengths(i) = 8: Next i
    HuffConstruct litHuff, lengths, FIXED_LIT

    For i = 0 To MAX_DIST_CODES - 1
        distLengths(i) = 5
    Next i
    HuffConstruct distHuff, distLengths, MAX_DIST_CODES

End Sub

'------------------------------------------------------------------------------
Private Sub BuildDynamicTables(ByRef litHuff As tHuffman, ByRef distHuff As tHuffman)

    Dim lengths(0 To MAX_CODES - 1) As Long
    Dim distLengths(0 To MAX_DIST_CODES - 1) As Long
    Dim lenHuff As tHuffman
    Dim nLen As Long, nDist As Long, nCode As Long
    Dim idx As Long, symbol As Long, repeat As Long, prevLen As Long

    nLen = GetBits(5) + 257
    nDist = GetBits(5) + 1
    nCode = GetBits(4) + 4

    If nLen > MAX_LIT_CODES Or nDist > MAX_DIST_CODES Then
        Err.Raise ERR_BASE + 7, "BuildDynamicTables", "Too many length or distance codes"
    End If

    For idx = 0 To nCode - 1
        lengths(m_clOrder(idx)) = GetBits(3)
    Next idx
    For idx = nCode To 18
        lengths(m_clOrder(idx)) = 0
    Next idx
    HuffConstruct lenHuff, lengths, 19

    idx = 0
    Do While idx < nLen + nDist
        symbol = HuffDecode(lenHuff)

        If symbol < 16 Then
            lengths(idx) = symbol
            idx = idx + 1
        Else
            prevLen = 0
            If symbol = 16 Then
                If idx = 0 Then
                    Err.Raise ERR_BASE + 8, "BuildDynamicTables", "No previous code length"
                End If
                prevLen = lengths(idx - 1)
                repeat = 3 + GetBits(2)
            ElseIf symbol = 17 Then
                repeat = 3 + GetBits(3)
            Else
                repeat = 11 + GetBits(7)
            End If

            If idx + repeat > nLen + nDist Then
                Err.Raise ERR_BASE + 9, "BuildDynamicTables", "Too many code lengths"
            End If
            Do While repeat > 0
                lengths(idx) = prevLen
                idx = idx + 1
                repeat = repeat - 1
            Loop
        End If
    Loop

    HuffConstruct litHuff, lengths, nLen

    For idx = 0 To nDist - 1
        distLengths(idx) = lengths(nLen + idx)
    Next idx
    HuffConstruct distHuff, distLengths, nDist

End Sub

'------------------------------------------------------------------------------
Private Sub HuffConstruct(ByRef h As tHuffman, ByRef lengths() As Long, ByVal n As Long)

    Dim offs(0 To MAX_BITS) As Long
    Dim symbol As Long, bitLen As Long, leftCodes As Long

    For bitLen = 0 To MAX_BITS
        h.Cnt(bitLen) = 0
    Next bitLen

    For symbol = 0 To n - 1
        h.Cnt(lengths(symbol)) = h.Cnt(lengths(symbol)) + 1
    Next symbol

    leftCodes = 1
    For bitLen = 1 To MAX_BITS
        leftCodes = leftCodes * 2 - h.Cnt(bitLen)
        If leftCodes < 0 Then
            Err.Raise ERR_BASE + 10, "HuffConstruct", "Over-subscribed Huffman code set"
        End If
    Next bitLen

    offs(1) = 0
    For bitLen = 1 To MAX_BITS - 1
        offs(bitLen + 1) = offs(bitLen) + h.Cnt(bitLen)
    Next bitLen

    For symbol = 0 To n - 1
        If lengths(symbol) <> 0 Then
            h.Sym(offs(lengths(symbol))) = symbol
            offs(lengths(symbol)) = offs(lengths(symbol)) + 1
        End If
    Next symbol

End Sub

'------------------------------------------------------------------------------
Private Function HuffDecode(ByRef h As tHuffman) As Long

    Dim code As Long, first As Long, index As Long
    Dim count As Long, bitLen As Long

    For bitLen = 1 To MAX_BITS
        code = code Or GetBits(1)
        count = h.Cnt(bitLen)
        If code - first < count Then
            HuffDecode = h.Sym(index + (code - first))
            Exit Function
        End If
        index = index + count
        first = (first + count) * 2
        code = code * 2
    Next bitLen

    Err.Raise ERR_BASE + 11, "HuffDecode", "Invalid Huffman code"

End Function

'------------------------------------------------------------------------------
Private Function GetBits(ByVal need As Long) As Long

    Dim value As Long

    Do While m_bitCnt < need
        If m_inPos > m_inEnd Then
            Err.Raise ERR_BASE + 12, "GetBits", "Ran out of compressed data"
        End If
        m_bitBuf = m_bitBuf Or (CLng(m_in(m_inPos)) * m_pow2(m_bitCnt))
        m_inPos = m_inPos + 1
        m_bitCnt = m_bitCnt + 8
    Loop

    value = m_bitBuf And (m_pow2(need) - 1)
    m_bitBuf = m_bitBuf \ m_pow2(need)
    m_bitCnt = m_bitCnt - need
    GetBits = value

End Function

'------------------------------------------------------------------------------
Private Sub OutByte(ByVal b As Byte)

    If m_outLen >= m_outCap Then
        m_outCap = m_outCap * 2
        ReDim Preserve m_out(0 To m_outCap - 1)
    End If
    m_out(m_outLen) = b
