Private Sub ResetCollectors()

    m_txN = 0: m_segN = 0: m_recN = 0: m_vRuleN = 0: m_hRuleN = 0

    ReDim m_txX(0 To 1023): ReDim m_txY(0 To 1023): ReDim m_txSz(0 To 1023)
    ReDim m_txFont(0 To 1023): ReDim m_txStr(0 To 1023)
    ReDim m_segX1(0 To 1023): ReDim m_segY1(0 To 1023)
    ReDim m_segX2(0 To 1023): ReDim m_segY2(0 To 1023)
    ReDim m_recX(0 To 255): ReDim m_recY(0 To 255)
    ReDim m_recW(0 To 255): ReDim m_recH(0 To 255)
    ReDim m_vRuleX(0 To 1023): ReDim m_hRuleY(0 To 1023)

    m_minX = 1E+30: m_maxX = -1E+30
    m_minY = 1E+30: m_maxY = -1E+30

    Set m_fonts = New Collection
    Set m_widths = New Collection
    Set m_images = New Collection

End Sub

'------------------------------------------------------------------------------
' Walks the page operators, tracking the text matrix so that every reported
' coordinate is absolute even when the producer used relative Td offsets.
'------------------------------------------------------------------------------
Private Sub AnalyseContent(ByVal content As String)

    Dim toks() As String
    Dim n As Long, i As Long
    Dim tok As String
    Dim h0 As String, h1 As String, h2 As String, h3 As String, h4 As String, h5 As String
    Dim lineX As Double, lineY As Double
    Dim fontName As String, fontSize As Double
    Dim moveX As Double, moveY As Double
    Dim x1 As Double, y1 As Double, x2 As Double, y2 As Double
    Dim w As Double, hgt As Double
    Dim lastStr As String, arrStr As String
    Dim inArray As Boolean
    Dim ctmA As Double, ctmD As Double, ctmE As Double, ctmF As Double

    ctmA = 1: ctmD = 1
    n = Tokenize(content, toks)

    For i = 0 To n - 1
        tok = toks(i)

        Select Case tok

            Case "Tf"
                fontSize = Val(h0)
                fontName = h1
                AddUniqueText m_fonts, fontName & "@" & NumTxt(fontSize)

            Case "w"
                AddUniqueText m_widths, NumTxt(Val(h0))

            Case "BT"
                lineX = 0: lineY = 0

            Case "Tm"
                lineX = Val(h1): lineY = Val(h0)

            Case "Td", "TD"
                lineX = lineX + Val(h1)
                lineY = lineY + Val(h0)

            Case "T*"
                lineY = lineY - fontSize * 1.2

            Case "Tj", "'"
                AddText lineX, lineY, fontSize, fontName, lastStr

            Case "TJ"
                AddText lineX, lineY, fontSize, fontName, arrStr
                arrStr = vbNullString

            Case "["
                inArray = True: arrStr = vbNullString

            Case "]"
                inArray = False

            Case "m"
                moveX = Val(h1): moveY = Val(h0)

            Case "l"
                x2 = Val(h1): y2 = Val(h0)
                x1 = moveX: y1 = moveY
                If Abs(x1 - x2) <= TOL Then
                    AddSegment x1, y1, x2, y2
                    AddRule m_vRuleX, m_vRuleN, x1
                ElseIf Abs(y1 - y2) <= TOL Then
                    AddSegment x1, y1, x2, y2
                    AddRule m_hRuleY, m_hRuleN, y1
                End If
                moveX = x2: moveY = y2

            Case "re"
                x1 = Val(h3): y1 = Val(h2): w = Val(h1): hgt = Val(h0)
                Track x1, y1
                Track x1 + w, y1 + hgt
                If Abs(w) <= RULE_MAX_THICK Then
                    AddRule m_vRuleX, m_vRuleN, x1
                    AddSegment x1, y1, x1, y1 + hgt
                ElseIf Abs(hgt) <= RULE_MAX_THICK Then
                    AddRule m_hRuleY, m_hRuleN, y1
                    AddSegment x1, y1, x1 + w, y1
                Else
                    ' Oracle Reports draws every table cell as a rectangle, so the
                    ' four edges are the real column and row grid.
                    AddRect x1, y1, w, hgt
                    AddRule m_vRuleX, m_vRuleN, x1
                    AddRule m_vRuleX, m_vRuleN, x1 + w
                    AddRule m_hRuleY, m_hRuleN, y1
                    AddRule m_hRuleY, m_hRuleN, y1 + hgt
                End If

            Case "cm"
                ctmA = Val(h5): ctmD = Val(h2)
                ctmE = Val(h1): ctmF = Val(h0)

            Case "Do"
                AddUniqueText m_images, h0 & ": scale " & NumTxt(ctmA) & " x " & NumTxt(ctmD) & _
                                        " at " & NumTxt(ctmE) & " " & NumTxt(ctmF)
        End Select

        If Len(tok) > 0 Then
            If Left$(tok, 1) = "(" Then
                lastStr = Mid$(tok, 2)
                If inArray Then arrStr = arrStr & lastStr
            End If
        End If

        h5 = h4: h4 = h3: h3 = h2: h2 = h1: h1 = h0: h0 = tok
    Next i

End Sub

'------------------------------------------------------------------------------
Private Sub AddText(ByVal x As Double, ByVal y As Double, ByVal size As Double, _
                    ByVal fontName As String, ByVal s As String)

    If Len(Trim$(s)) = 0 Then Exit Sub

    If m_txN > UBound(m_txX) Then
        ReDim Preserve m_txX(0 To m_txN * 2)
        ReDim Preserve m_txY(0 To m_txN * 2)
        ReDim Preserve m_txSz(0 To m_txN * 2)
        ReDim Preserve m_txFont(0 To m_txN * 2)
        ReDim Preserve m_txStr(0 To m_txN * 2)
    End If

    m_txX(m_txN) = x: m_txY(m_txN) = y: m_txSz(m_txN) = size
    m_txFont(m_txN) = fontName: m_txStr(m_txN) = s
    m_txN = m_txN + 1

    Track x, y

End Sub

'------------------------------------------------------------------------------
Private Sub AddSegment(ByVal x1 As Double, ByVal y1 As Double, _
                       ByVal x2 As Double, ByVal y2 As Double)

    If m_segN > UBound(m_segX1) Then
        ReDim Preserve m_segX1(0 To m_segN * 2)
        ReDim Preserve m_segY1(0 To m_segN * 2)
        ReDim Preserve m_segX2(0 To m_segN * 2)
        ReDim Preserve m_segY2(0 To m_segN * 2)
    End If

    m_segX1(m_segN) = x1: m_segY1(m_segN) = y1
    m_segX2(m_segN) = x2: m_segY2(m_segN) = y2
    m_segN = m_segN + 1

    Track x1, y1
    Track x2, y2

End Sub

'------------------------------------------------------------------------------
Private Sub AddRect(ByVal x As Double, ByVal y As Double, _
                    ByVal w As Double, ByVal h As Double)

    If m_recN > UBound(m_recX) Then
        ReDim Preserve m_recX(0 To m_recN * 2)
        ReDim Preserve m_recY(0 To m_recN * 2)
        ReDim Preserve m_recW(0 To m_recN * 2)
        ReDim Preserve m_recH(0 To m_recN * 2)
    End If

    m_recX(m_recN) = x: m_recY(m_recN) = y
    m_recW(m_recN) = w: m_recH(m_recN) = h
    m_recN = m_recN + 1

End Sub

'------------------------------------------------------------------------------
Private Sub AddRule(ByRef arr() As Double, ByRef count As Long, ByVal v As Double)

    If count > UBound(arr) Then ReDim Preserve arr(0 To count * 2)
    arr(count) = v
    count = count + 1

End Sub

'------------------------------------------------------------------------------
Private Sub Track(ByVal x As Double, ByVal y As Double)

    If x < m_minX Then m_minX = x
    If x > m_maxX Then m_maxX = x
    If y < m_minY Then m_minY = y
    If y > m_maxY Then m_maxY = y

End Sub


'==============================================================================
' TOKENIZER
'==============================================================================

Private Function Tokenize(ByVal s As String, ByRef toks() As String) As Long

    Dim i As Long, n As Long, j As Long, depth As Long
    Dim count As Long
    Dim ch As String
    Dim buf As String

    n = Len(s)
    ReDim toks(0 To 4095)

    i = 1
    Do While i <= n
        ch = Mid$(s, i, 1)

        If ch = " " Or ch = vbCr Or ch = vbLf Or ch = vbTab Or ch = Chr$(0) Then
            i = i + 1

        ElseIf ch = "(" Then
            depth = 1: j = i + 1: buf = vbNullString
            Do While j <= n And depth > 0
                ch = Mid$(s, j, 1)
                If ch = "\" Then
                    buf = buf & Mid$(s, j + 1, 1)
                    j = j + 2
                Else
                    If ch = "(" Then
                        depth = depth + 1
                    ElseIf ch = ")" Then
                        depth = depth - 1
                        If depth = 0 Then Exit Do
                    End If
                    buf = buf & ch
                    j = j + 1
                End If
            Loop
            PushToken toks, count, "(" & buf
            i = j + 1

        ElseIf ch = "/" Then
            j = i + 1
            Do While j <= n
                If IsDelimiter(Mid$(s, j, 1)) Then Exit Do
                j = j + 1
            Loop
            PushToken toks, count, Mid$(s, i, j - i)
            i = j

        ElseIf ch = "[" Or ch = "]" Then
            PushToken toks, count, ch
            i = i + 1

        ElseIf ch = "<" Or ch = ">" Or ch = "{" Or ch = "}" Then
            i = i + 1

        Else
            j = i
            Do While j <= n
                If IsDelimiter(Mid$(s, j, 1)) Then Exit Do
                j = j + 1
            Loop
            If j = i Then j = i + 1
            PushToken toks, count, Mid$(s, i, j - i)
            i = j
        End If
    Loop

    Tokenize = count

End Function

Private Sub PushToken(ByRef toks() As String, ByRef count As Long, ByVal t As String)

    If count > UBound(toks) Then ReDim Preserve toks(0 To count * 2)
    toks(count) = t
    count = count + 1

End Sub

Private Function IsDelimiter(ByVal ch As String) As Boolean

    Select Case ch
        Case " ", vbCr, vbLf, vbTab, "(", ")", "<", ">", "[", "]", "{", "}", "/", "%"
            IsDelimiter = True
    End Select

End Function


'==============================================================================
' PDF OBJECT ACCESS
'==============================================================================

Private Sub BuildObjectIndex()

    Dim p As Long, k As Long
    Dim head As String
    Dim parts() As String
    Dim numTxt As String
    Dim seenGen As Boolean

    m_objCount = 0
    ReDim m_objNum(0 To 255)
    ReDim m_objPos(0 To 255)

    p = 0
    Do
        p = FindBytes(m_pdf, p, " obj")
        If p < 0 Then Exit Do

        head = BytesText(m_pdf, IIf(p - 24 < 0, 0, p - 24), p - 1)
        head = Replace(Replace(head, vbCr, " "), vbLf, " ")
        parts = Split(Trim$(head), " ")

        numTxt = vbNullString
        seenGen = False
        For k = UBound(parts) To LBound(parts) Step -1
            If Len(parts(k)) > 0 Then
                If IsNumeric(parts(k)) Then
                    If Not seenGen Then
                        seenGen = True                    ' generation number
                    Else
                        numTxt = parts(k)                 ' object number
                        Exit For
                    End If
                Else
                    Exit For
                End If
            End If
        Next k

        If Len(numTxt) > 0 Then
            If m_objCount > UBound(m_objNum) Then
                ReDim Preserve m_objNum(0 To m_objCount * 2)
                ReDim Preserve m_objPos(0 To m_objCount * 2)
            End If
            m_objNum(m_objCount) = CLng(numTxt)
            m_objPos(m_objCount) = p + 4
            m_objCount = m_objCount + 1
        End If

        p = p + 4
    Loop

End Sub

'------------------------------------------------------------------------------
Private Function IndexOfObject(ByVal objNo As Long) As Long

    Dim i As Long

    For i = 0 To m_objCount - 1
        If m_objNum(i) = objNo Then
            IndexOfObject = i
            Exit Function
        End If
    Next i

    IndexOfObject = -1

End Function

'------------------------------------------------------------------------------
Private Function ObjectDict(ByVal pos As Long) As String

    Dim eStream As Long, eObj As Long, stopAt As Long

    eStream = FindBytes(m_pdf, pos, "stream")
    eObj = FindBytes(m_pdf, pos, "endobj")

    If eStream < 0 Then
        stopAt = eObj
    ElseIf eObj < 0 Then
        stopAt = eStream
    ElseIf eStream < eObj Then
        stopAt = eStream
    Else
        stopAt = eObj
    End If

    If stopAt < 0 Then stopAt = pos + 2000
    If stopAt - pos > 4000 Then stopAt = pos + 4000

    ObjectDict = Replace(Replace(BytesText(m_pdf, pos, stopAt - 1), vbCr, " "), vbLf, " ")

End Function

'------------------------------------------------------------------------------
' First and last data byte of the stream belonging to the object at pos.
'------------------------------------------------------------------------------
Private Function StreamBounds(ByVal pos As Long, ByRef dStart As Long, ByRef dEnd As Long) As Boolean

    Dim sPos As Long, ePos As Long, oPos As Long
    Dim declared As Long
    Dim probe As String

    sPos = FindBytes(m_pdf, pos, "stream")
    oPos = FindBytes(m_pdf, pos, "endobj")
    If sPos < 0 Then Exit Function
    If oPos >= 0 And sPos > oPos Then Exit Function

    dStart = sPos + 6
    If dStart > UBound(m_pdf) Then Exit Function
    If m_pdf(dStart) = 13 Then dStart = dStart + 1
    If m_pdf(dStart) = 10 Then dStart = dStart + 1

    declared = DeclaredLength(ObjectDict(pos))
    If declared > 0 Then
        If dStart + declared + 20 <= UBound(m_pdf) Then
            probe = BytesText(m_pdf, dStart + declared, dStart + declared + 20)
            If InStr(1, probe, "endstream") > 0 Then
                dEnd = dStart + declared - 1
                StreamBounds = True
                Exit Function
            End If
        End If
    End If

    ePos = FindBytes(m_pdf, dStart, "endstream")
    If ePos < 0 Then Exit Function
    dEnd = ePos - 1
    Do While dEnd >= dStart
        If m_pdf(dEnd) <> 10 And m_pdf(dEnd) <> 13 Then Exit Do
        dEnd = dEnd - 1
    Loop

    StreamBounds = True

End Function

'------------------------------------------------------------------------------
Private Function DeclaredLength(ByVal dictTxt As String) As Long

    Dim k As Long, i As Long
    Dim ch As String, num As String, tail As String

    k = InStr(1, dictTxt, "/Length")
    If k = 0 Then Exit Function

    i = k + 7
    Do While i <= Len(dictTxt)
        If Mid$(dictTxt, i, 1) <> " " Then Exit Do
        i = i + 1
    Loop

    Do While i <= Len(dictTxt)
        ch = Mid$(dictTxt, i, 1)
        If ch < "0" Or ch > "9" Then Exit Do
        num = num & ch
        i = i + 1
    Loop
    If Len(num) = 0 Then Exit Function

    tail = LTrim$(Mid$(dictTxt, i, 6))
    If Len(tail) > 0 Then
        If tail Like "#*" Then Exit Function              ' indirect /Length n 0 R
    End If

    DeclaredLength = CLng(num)

End Function

'------------------------------------------------------------------------------
Private Function ZlibSkip(ByVal dStart As Long) As Long

    Dim b0 As Long, b1 As Long

    If dStart + 1 > UBound(m_pdf) Then Exit Function
    b0 = m_pdf(dStart)
    b1 = m_pdf(dStart + 1)

    If (b0 And &HF) = 8 Then
        If ((b0 * 256 + b1) Mod 31) = 0 Then ZlibSkip = 2
    End If

End Function

'------------------------------------------------------------------------------
Private Function PageObjectOrder() As String

    Dim i As Long
    Dim dict As String
    Dim result As String

    For i = 0 To m_objCount - 1
        dict = ObjectDict(m_objPos(i))
        If InStr(1, dict, "/Type/Pages") > 0 Or InStr(1, dict, "/Type /Pages") > 0 Then
            result = RefList(dict, "/Kids")
            If Len(result) > 0 Then
                PageObjectOrder = result
                Exit Function
            End If
        End If
    Next i

    For i = 0 To m_objCount - 1
        dict = ObjectDict(m_objPos(i))
        If InStr(1, dict, "/Type/Pages") = 0 Then
            If InStr(1, dict, "/Type/Page") > 0 Then
                If Len(result) > 0 Then result = result & ","
                result = result & CStr(m_objNum(i))
            End If
        End If
    Next i

    PageObjectOrder = result

End Function

'------------------------------------------------------------------------------
Private Function PageContent(ByVal pageDict As String) As String

    Dim refs() As String
    Dim list As String
    Dim i As Long, objIdx As Long
    Dim s As String

    list = RefList(pageDict, "/Contents")
    If Len(list) = 0 Then Exit Function

    refs = Split(list, ",")
    For i = LBound(refs) To UBound(refs)
        objIdx = IndexOfObject(CLng(refs(i)))
        If objIdx >= 0 Then
            s = s & StreamText(m_objPos(objIdx)) & vbLf
        End If
    Next i

    PageContent = s

End Function

'------------------------------------------------------------------------------
Private Function StreamText(ByVal pos As Long) As String

    Dim dict As String
    Dim dStart As Long, dEnd As Long
    Dim plain() As Byte
    Dim plainLen As Long
    Dim errText As String

    If Not StreamBounds(pos, dStart, dEnd) Then Exit Function
    dict = ObjectDict(pos)

    If InStr(1, dict, "/FlateDecode") = 0 Then
        StreamText = BytesText(m_pdf, dStart, dEnd)
        Exit Function
    End If

    If TryInflate(m_pdf, dStart + ZlibSkip(dStart), dEnd, plain, plainLen, errText) Then
        If plainLen > 0 Then
            ReDim Preserve plain(0 To plainLen - 1)
            StreamText = StrConv(plain, vbUnicode)
        End If
    End If

End Function

'------------------------------------------------------------------------------
Private Function RefList(ByVal dict As String, ByVal key As String) As String

    Dim k As Long, i As Long, j As Long, stopAt As Long
    Dim seg As String
    Dim parts() As String
    Dim result As String

    k = InStr(1, dict, key)
    If k = 0 Then Exit Function

    i = k + Len(key)
    Do While i <= Len(dict)
        If Mid$(dict, i, 1) <> " " Then Exit Do
        i = i + 1
    Loop

    If Mid$(dict, i, 1) = "[" Then
        stopAt = InStr(i, dict, "]")
        If stopAt = 0 Then stopAt = i + 200
        seg = Mid$(dict, i + 1, stopAt - i - 1)
    Else
        ' Single reference: "/Contents 2 0 R/CropBox[...]" - PDF puts no space
        ' before the next key, so cut the segment at the first delimiter.
        seg = Mid$(dict, i, 20)
        stopAt = 0
        For j = 1 To Len(seg)
            If InStr("/>]", Mid$(seg, j, 1)) > 0 Then
                stopAt = j
                Exit For
            End If
        Next j
        If stopAt > 0 Then seg = Left$(seg, stopAt - 1)
    End If

    Do While InStr(seg, "  ") > 0
        seg = Replace(seg, "  ", " ")
    Loop

    parts = Split(Trim$(seg), " ")
    For i = LBound(parts) To UBound(parts)
        If parts(i) = "R" And i >= 2 Then
            If Len(result) > 0 Then result = result & ","
            result = result & parts(i - 2)
        End If
    Next i

    RefList = result

End Function

'------------------------------------------------------------------------------
Private Function DictValue(ByVal dict As String, ByVal key As String) As String

    Dim k As Long, i As Long, depth As Long
    Dim ch As String
    Dim s As String

    k = InStr(1, dict, key)
    If k = 0 Then
        DictValue = "(absent)"
        Exit Function
    End If

    i = k + Len(key)
    Do While i <= Len(dict)
        If Mid$(dict, i, 1) <> " " Then Exit Do
        i = i + 1
    Loop

    Do While i <= Len(dict)
        ch = Mid$(dict, i, 1)
        s = s & ch
        If ch = "[" Or ch = "<" Then depth = depth + 1
        If ch = "]" Or ch = ">" Then
            depth = depth - 1
            If depth <= 0 Then Exit Do
        End If
        If depth = 0 And Len(s) > 1 Then
            If ch = " " Or ch = "/" Then Exit Do
        End If
        If Len(s) > 120 Then Exit Do
        i = i + 1
    Loop

    DictValue = Trim$(s)

End Function



