Option Explicit

'==============================================================================
' Module      : modPdfReport
' Purpose     : One-run PDF layout analyser. Reads a PDF, decompresses every
'               /FlateDecode stream with a pure-VBA DEFLATE decoder, resolves the
'               text matrix and writes FIVE files in a single pass:
'
'                 <name>_streams.txt  full decompressed streams (page operators)
'                 <name>_layout.txt   full coordinate lists, per page
'                 <name>_spec.txt     short spec: column / row vectors, RLE
'                 <name>_columns.txt  human-readable rectangle bands
'                 <name>_oracle_schema.txt compact Oracle table schema and rows
'
' Dependencies: none - no references, no external tools, no admin rights
' Entry points: RunPdfAnalysis       - edit the two constants and press F5
'               RunPdfAnalysisBrowse - choose a PDF and write beside it
'               PdfAnalyse           - programmatic call
' Notes       : replaces modPdfInflate and modPdfCompact - remove those two
'               modules before importing this one.
'               Inflate is a port of the public-domain "puff" implementation and
'               was verified against zlib output at levels 0/1/6/9.
'==============================================================================

'--- DEFLATE ------------------------------------------------------------------
Private Const MAX_BITS       As Long = 15
Private Const MAX_LIT_CODES  As Long = 286
Private Const MAX_DIST_CODES As Long = 30
Private Const MAX_CODES      As Long = 316
Private Const FIXED_LIT      As Long = 288

'--- analysis -----------------------------------------------------------------
Private Const TOL           As Double = 1#     ' coordinate clustering tolerance
                                               ' 0.6 was too tight: Oracle jitters
                                               ' baselines by 0.76 pt, which split
                                               ' every text row into two clusters
Private Const RULE_MAX_THICK As Double = 2#    ' a thinner "re" counts as a rule
Private Const MAX_ROW_ITEMS As Long = 40       ' items printed for one text row
Private Const ERR_BASE      As Long = vbObjectError + 3000

Private Const ORACLE_TOP_COLUMN_COUNT As Long = 12
Private Const ORACLE_BOTTOM_COLUMN_COUNT As Long = 13
Private Const ORACLE_TABLE_LEFT_X As Double = 40.52
Private Const ORACLE_TABLE_RIGHT_X As Double = 1323.04
Private Const ORACLE_MIN_DATA_ROW_STEP As Double = 16#
Private Const ORACLE_MAX_DATA_ROW_STEP As Double = 20#
Private Const ORACLE_GRID_MATCH_TOLERANCE As Double = 1#
Private Const ORACLE_FIRST_PAGE_MAX_TRADES As Long = 11
Private Const ORACLE_CONTINUATION_PAGE_MAX_TRADES As Long = 12

Private Type tHuffman
    Cnt(0 To MAX_BITS) As Long
    Sym(0 To FIXED_LIT - 1) As Long
End Type

