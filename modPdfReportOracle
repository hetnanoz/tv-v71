'==============================================================================
' CLUSTERING AND COMPRESSION
'==============================================================================

Private Function ClusterValues(ByRef src() As Double, ByVal n As Long, _
                               ByRef result() As Double, ByVal ascending As Boolean) As Long

    Dim tmp() As Double
    Dim i As Long, k As Long
    Dim swap As Double

    If n <= 0 Then
        ReDim result(0 To 0)
        Exit Function
    End If

    ReDim tmp(0 To n - 1)
    For i = 0 To n - 1
        tmp(i) = src(i)
    Next i

    QuickSortD tmp, 0, n - 1

    ReDim result(0 To n - 1)
    k = 0
    result(0) = tmp(0)
    For i = 1 To n - 1
        If tmp(i) - result(k) > TOL Then
            k = k + 1
            result(k) = tmp(i)
        End If
    Next i
    k = k + 1

    If Not ascending Then
        For i = 0 To k \ 2 - 1
            swap = result(i)
            result(i) = result(k - 1 - i)
            result(k - 1 - i) = swap
        Next i
    End If

    ClusterValues = k

End Function

'------------------------------------------------------------------------------
Private Sub QuickSortD(ByRef arr() As Double, ByVal lo As Long, ByVal hi As Long)

    Dim i As Long, j As Long
    Dim pivot As Double, swap As Double

    If lo >= hi Then Exit Sub

    i = lo: j = hi
    pivot = arr((lo + hi) \ 2)

    Do While i <= j
        Do While arr(i) < pivot
            i = i + 1
        Loop
        Do While arr(j) > pivot
            j = j - 1
        Loop
        If i <= j Then
            swap = arr(i): arr(i) = arr(j): arr(j) = swap
            i = i + 1: j = j - 1
        End If
    Loop

    If lo < j Then QuickSortD arr, lo, j
    If i < hi Then QuickSortD arr, i, hi

End Sub

'------------------------------------------------------------------------------
Private Function Diffs(ByRef arr() As Double, ByVal n As Long) As Double()

    Dim d() As Double
    Dim i As Long

    If n < 2 Then
        ReDim d(0 To 0)
        Diffs = d
        Exit Function
    End If

    ReDim d(0 To n - 2)
    For i = 0 To n - 2
        d(i) = Abs(arr(i + 1) - arr(i))
    Next i

    Diffs = d

End Function

'------------------------------------------------------------------------------
Private Function RunLength(ByRef arr() As Double, ByVal n As Long) As String

    Dim i As Long, runLen As Long
    Dim cur As Double
    Dim s As String

    If n <= 0 Then
        RunLength = "(none)"
        Exit Function
    End If

    cur = arr(0): runLen = 1
    For i = 1 To n - 1
        If Abs(arr(i) - cur) <= 0.05 Then
            runLen = runLen + 1
        Else
            s = s & NumTxt(cur) & IIf(runLen > 1, " x" & CStr(runLen), "") & " ; "
            cur = arr(i): runLen = 1
        End If
    Next i
    s = s & NumTxt(cur) & IIf(runLen > 1, " x" & CStr(runLen), "")

    RunLength = s

End Function


